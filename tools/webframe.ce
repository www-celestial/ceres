(* The draw list and the semantics tree of the invoices page as the browser's glue takes them, for tests/web/page.html:
   its texts measured by SDL3_ttf, as the page in a window, live from its app served in this program. Writes
   tests/web/invoices.bin and tests/web/invoices.json. cesia do webframe. *)
use examples/invoices/page
use examples/invoices/server
use src/sdl
use src/web
use std/fiber
use std/io
use std/json
use std/net
use std/sys
use std/text

store = server.Store()
l = net.Listen(0).Value
fiber.Spawn(() -> server.Serve(store, l))
app = web.App([web.Route("/", page.Page)], live = "/live")
w = sdl.Open("frame", 1100, 860, driver = "dummy").Value
ui = web.Start(app, 1100, 860, sdl.Measure(w), origin = "http://127.0.0.1:$(net.Port(l))")
start = sys.Now()
while not text.Contains("F-000001", "$(web.Semantics(ui))") and sys.Now() - start < 5
  sys.Sleep(0.01)
  ui = web.Update(ui)
end
frame = web.Frame(ui)
bytes = ""
for k in 1..5
  t = sys.Now()
  bytes = web.Encode(frame)
  io.Print("encoded in $(text.Decimals(2, (sys.Now() - t) * 1000)) ms: $(text.ByteLength(bytes)) bytes")
end
t = sys.Now()
tree = json.Text(web.Semantics(ui))
io.Print("semantics as JSON in $(text.Decimals(2, (sys.Now() - t) * 1000)) ms: $(text.ByteLength(tree)) bytes")
sys.Write("tests/web/invoices.bin", bytes).Value
sys.Write("tests/web/invoices.json", tree).Value
sdl.Close(w)
sys.Exit(0)
