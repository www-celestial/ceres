(** /invoices: add an invoice, the unpaid ones live, every invoice in a table, the unpaid sum by month. *)
use examples/invoices/check
use src/form
use src/web
use std/plot

defn Page(p)
  (** p is the page: its route, and its screen, the live connection to the app. *)
  clients = web.Live("clients", p)      (* a signal: the rows of the show "clients", kept up to date by the app *)
  unpaid = web.Live("unpaid", p)
  months = web.Live("months", p)
  draft = form.New({Client: missing, Due: missing, Amount: missing}, check.Invoice)
  web.Stack([
    web.Title("Invoices"),
    form.View(draft, () -> web.Act("addInvoice", form.Values(draft), p), [
      form.Choice("Client", clients, c -> c.Id, c -> c.Name),
      form.Date("Due"),
      form.Number("Amount"),
      form.Submit("Add"),
    ]),
    web.Row([
      web.Grow(web.Stack([
        web.Text("Unpaid", strong = true),
        web.Each(unpaid, i -> i.Invoice, i -> web.Row([web.Text(i.Number), web.Text(i.BillTo, color = 0x59636e), web.Spacer(), web.Money(i.Total)]), gap = 6),
      ], gap = 8, pad = 12, border = 0xd1d9e0, radius = 6)),
      web.Plot(() -> plot.Of([plot.Bars([m.Month for m in web.Get(months)], [m.Total for m in web.Get(months)])], title = "Unpaid by month"), width = 520, height = 250),
    ], align = "start", gap = 16),
    web.Table(web.Pages("all", p), [
      web.Column("Number", i -> i.Number, sort = "Number", width = 160),
      web.Column("Client", i -> i.BillTo, sort = "BillTo"),
      web.Column("Total", i -> web.Money(i.Total), align = "right", width = 160),
    ], height = 300, label = "All invoices"),
  ])
end
