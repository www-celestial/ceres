(* The page's side of std/live, in Cesia: a screen of the app over a WebSocket, its shows as signals, its actions. The
   same protocol as live.js: {Hello: 2} first (its token and the last frame it has after a break), then the app's
   frames, each a JSON list of messages {Show, Group, Rows}, {Show, Group, Added, Removed}, {Ack, Ok} or {Ack, Err}, and
   {Error}, numbered by a first {Seq} and confirmed by {Got}; the app's first frame, {Token, Resumed, Heard, Who,
   Client}, says whether the screen is the one the page had. A fiber holds the connection: it says hello, passes each
   frame on to the fiber of the page, which alone sets the signals at its next update, pings, confirms, and comes back
   after a break. The fiber of the page keeps the actions in order, each with its key, until their replies. *)
use std/bug
use std/dict
use std/encode
use std/fiber
use std/json
use std/list
use std/math
use std/random
use std/result
use std/sys
use std/text
use std/value
use std/websocket

(* What a page does about its connection, until the app's own settings come with its screen ({Client}). *)
defaults = {Outbox: "on", OutboxCount: 100, OutboxBytes: 1048576, OutboxWait: 3600, ReconnectFirst: 500, ReconnectMax: 30000, PingEvery: 15, DeadAfter: 30}

defn Connect(url, headers = [], wake = missing, net = missing, settings = {}, telemetry = missing)
  (** Opens a screen of the app at url, a ws:// URL, as web.Start does with the app's live path: its shows and actions
      for the page, a screen that comes back by itself after a break, to the same screen while the app keeps it
      (every frame missed, once), else to a new one whose answers replace the rows. The wait before each try is drawn
      at random up to a bound that doubles at each failure (full jitter), from ReconnectFirst to ReconnectMax
      milliseconds; no frame for DeadAfter seconds (a ping goes every PingEvery) is a break. headers go with each
      handshake, as the session's token of a native app. wake, a channel, gets "live" each time the screen passes
      something on, for a back-end that waits on its own channel, as the browser's does. net, a channel, gets the
      browser's "online" and "offline", and "now" to try at once. settings are the page's own, over the app's.
      telemetry, a channel, gets "up" (with the app's settings of telemetry) and "down" as the screen connects and
      breaks, and each action answered, its name, its time from the click, its trace and the server's.

      The screen is {Up, Error, Status, Conflicts, ...}: Up a signal, true while connected; Error a signal of the error
      that ended the screen, or missing; Status a signal of {State, Waiting, Retry, Last, At, Offline, Error}, State
      "connecting", "up", "down" or "ended", Waiting the actions not answered yet, Retry the seconds before the next try
      while down, Last "resumed" or "reloaded" after a break, at the time At; Conflicts a signal of the actions the app
      refused as their thing changed meanwhile (web.Connection shows them). *)
  s = {Url: url, Inbox: fiber.Channel(), Stop: fiber.Channel(), Out: cell(missing), Shows: cell(dict.Dict()),
    Acts: cell(dict.Dict()), Next: cell(1), Up: Signal(false), Error: Signal(missing), Wake: wake, Ever: cell(false),
    Net: if value.IsMissing(net) fiber.Channel() else net end, Given: settings, Settings: cell(dict.Merge(defaults, settings)),
    Outbox: cell([]), Who: cell(missing), State: cell({State: "connecting", Retry: missing, Last: missing, At: 0, Offline: false}),
    Status: Signal({State: "connecting", Waiting: 0, Retry: missing, Last: missing, At: 0, Offline: false, Error: missing}),
    Conflicts: Signal([]), Tel: telemetry}
  fiber.Spawn(() -> dialing(s, headers))
  s
end

defn stopped(s)
  (** Did Close end the screen? *)
  got = fiber.Receive(s.Stop, timeout = 0)
  result.IsErr(got) and got.Error.Kind == "closed"
end

defn seqOf(m)
  (** The number of a frame that starts with {Seq}, or 0, read without parsing the frame. *)
  if not text.StartsWith("[{\"Seq\":", m)
    return 0
  end
  k = text.ByteFind("}", 1, m)
  if value.IsMissing(k) 0 else text.Number(text.ByteSlice(9, k - 1, m)) end
end

defn dialing(s, headers)
  (** The fiber of a screen: connects, says hello, passes on each frame, pings and confirms, and connects again after a
      break, after a wait drawn at random (full jitter), or at once when the browser says it is online again. After an
      {Error} it waits for Again. *)
  token = missing
  seq = 0
  version = 2
  bare = 0
  halted = false
  o = s.Given
  first = dict.GetOr("ReconnectFirst", 500, o)
  most = dict.GetOr("ReconnectMax", 30000, o)
  bound = first
  while not stopped(s)
    opened = sys.Now()
    got = websocket.Dial(s.Url, headers = headers, last = json.Text({Bye: 1}))
    framed = false
    if result.IsOk(got)
      conn = got.Value
      hello = if version == 1 {Hello: 1} else if value.IsMissing(token) {Hello: 2} else {Hello: 2, Token: token, Got: seq} end
      _ = websocket.Send(json.Text(hello), conn)
      if version == 1
        tell({Kind: "up", Conn: conn, Resumed: false, Heard: 0}, s)
      end
      last = sys.Now()
      told = seq
      ping = dict.GetOr("PingEvery", 15, o)
      dead = dict.GetOr("DeadAfter", 30, o)
      pinged = sys.Now()
      while true
        owing = seq > told
        wait = list.Max([0, list.Min([pinged + ping - sys.Now(), if owing 1 else ping end])])
        m = fiber.Select([conn.Messages, s.Net, s.Stop], timeout = wait)
        if result.IsErr(m) and m.Error.Kind == "timeout"
          break if sys.Now() - last > dead
          if sys.Now() >= pinged + ping or owing
            msg = if seq > 0 json.Text({Ping: sys.Now() * 1000, Got: seq}) else json.Text({Ping: sys.Now() * 1000}) end
            break if result.IsErr(websocket.Send(msg, conn))
            told = seq
            pinged = sys.Now()
          end
        else if result.IsErr(m)
          break
        else if m.Value.Channel == s.Net
          heardNet(m.Value.Value, s)
          break if m.Value.Value == "offline"
        else
          t = m.Value.Value
          last = sys.Now()
          framed = true
          if text.StartsWith("[{\"Token\":", t)
            h = json.Parse(t)
            if result.IsOk(h) and value.IsArray(h.Value) and value.IsDict(h.Value[1])
              x = h.Value[1]
              if x.Resumed != true
                seq = 0
                told = 0
              end
              token = x.Token
              c = dict.GetOr("Client", {}, x)
              o = dict.Merge(if value.IsDict(c) c else {} end, s.Given)
              ping = dict.GetOr("PingEvery", 15, o)
              dead = dict.GetOr("DeadAfter", 30, o)
              first = dict.GetOr("ReconnectFirst", 500, o)
              most = dict.GetOr("ReconnectMax", 30000, o)
              bound = first
              tell({Kind: "up", Conn: conn, Resumed: x.Resumed == true, Heard: dict.GetOr("Heard", 0, x), Who: dict.Get("Who", x), Client: o}, s)
            end
          else
            if text.StartsWith("[{\"Error\":", t)
              halted = true
            end
            n = seqOf(t)
            if n == 0 or n > seq
              if n > 0
                seq = n
              end
              tell({Kind: "frame", Text: t}, s)
            end
          end
        end
      end
      fiber.Spawn(() -> websocket.Close(conn))
      if version == 2 and not framed and value.IsMissing(token) and sys.Now() - opened < 2
        bare += 1
        version = if bare >= 2 1 else 2 end   (* an app of the version before closes a hello 2 at once, saying nothing *)
      end
      tell({Kind: "down"}, s)
    end
    break if stopped(s)
    if halted
      (* an {Error} ended the screen: it comes back only when the page asks (Again), as a new one *)
      while true
        n = fiber.Select([s.Net, s.Stop])
        break if result.IsErr(n)
        heardNet(n.Value.Value, s)
        break if n.Value.Value == "now"
      end
      halted = false
      token = missing
      seq = 0
      bound = first
    else
      until = sys.Now() + random.Float() * list.Min([most, bound]) / 1000
      bound = list.Min([most, bound * 2])
      while sys.Now() < until
        tell({Kind: "wait", Until: until}, s)
        n = fiber.Select([s.Net, s.Stop], timeout = list.Max([0, list.Min([1, until - sys.Now()])]))
        if result.IsErr(n)
          break if n.Error.Kind == "closed"
        else
          heardNet(n.Value.Value, s)
          break if n.Value.Value == "online" or n.Value.Value == "now"
        end
      end
    end
  end
end

defn heardNet(word, s)
  (** The browser's word on its network, passed on to the page: offline, or online again. *)
  if word == "offline" or word == "online"
    tell({Kind: "net", Offline: word == "offline"}, s)
  end
end

defn tell(e, s)
  (** Passes e on to the fiber of the page, and wakes its back-end if it asked. *)
  fiber.Send(e, s.Inbox)
  if value.IsSome(s.Wake)
    fiber.Send("live", s.Wake)
  end
end

defn Close(screen)
  (** Ends a screen: it says Bye, so that the app ends it at once, its connection closes, and it doesn't come back. *)
  fiber.Close(screen.Stop)
  conn = peek(screen.Out)
  if value.IsSome(conn)
    fiber.Spawn(defn ()
      _ = websocket.Send(json.Text({Bye: 1}), conn)
      websocket.Close(conn)
    end)
  end
  missing
end

defn Again(screen)
  (** Tries to connect now: after a sign-in that follows the end of the screen (its session gone), the page comes back
      as a new screen with its actions; while down, the next try is now. *)
  if value.IsSome(untracked(screen.Error))
    Set(screen.Error, missing)
    st = peek(screen.State)
    st.State = "connecting"
    put(st, screen.State)
    status(screen)
  end
  fiber.Send("now", screen.Net)
  missing
end

defn showOf(name, screen)
  (** The show of a name, made when first asked for: {Signal, Tally}, Tally its rows by their JSON, with their count. *)
  shows = peek(screen.Shows)
  if not (name in shows)
    shows[name] = {Signal: Signal([]), Tally: dict.Dict()}
    put(shows, screen.Shows)
  end
  shows[name]
end

defn Live(name, p)
  (** The rows of the show name of the page's screen, as a signal kept up to date as the app pushes its changes: the
      answer of a question that the app's screen asks, as cepheus.Watch keeps one. An empty list until the first answer.
      The page never writes the question: it names a show, the app writes it with the user's values. *)
  if value.IsMissing(p.Screen)
    bug.Panic("This page has no live screen: web.App(..., live = \"/live\") gives it one, with the origin of the app.")
  end
  showOf(name, p.Screen).Signal
end

defn Act(name, args, p, base = missing, mine = missing, read = false)
  (** Asks the app for the action name with args: a signal of the reply, missing until it comes, then the Ok of what
      the action gave or its Err. The app checks args again: the page is never trusted. While the page is away from its
      app, the action waits, in order, with the key it got now, and goes once the page is back: the app runs it once.
      base, the values the page saw of what the action changes ({Total: 120}), lets the app refuse it when they changed
      meanwhile: its Err is then of the kind "conflict", with each field's value now; mine, the values the action
      writes, when its args don't hold them as fields, for web.Conflicts to show beside. read, true for an action that
      only reads (a list asked): it waits as the others, but the line of the connection counts only the changes. *)
  out = Signal(missing)
  actThen(name, args, p.Screen, m -> Set(out, result.Err(m.Err) if "Err" in m else result.Ok(m.Ok)), base = base, mine = mine, read = read)
  out
end

(* The key of an action, made when it is asked: 128 random bits, as hex. *)
newKey() = encode.Hex(text.FromBytes([math.Div(math.Floor(random.Float() * 256), 1) for k in 1..16]))

defn actThen(name, args, screen, reply, base = missing, mine = missing, read = false)
  (** Sends an action, or keeps it until the screen is up, and calls reply(m) with its reply, {Ack, Ok} or {Ack, Err},
      on the page's fiber. With the outbox off, an action asked while the screen is down gets an Err at once. *)
  o = peek(screen.Settings)
  st = peek(screen.State)
  up = st.State == "up"
  if o.Outbox == "off" and not up and peek(screen.Ever)
    reply({Err: {Kind: "live", Message: "This page is not connected to its app."}})
    return missing
  end
  if st.State == "ended" and value.IsSome(untracked(screen.Error)) and dict.Get("Status", untracked(screen.Error)) != 401
    reply({Err: untracked(screen.Error)})
    return missing
  end
  box = peek(screen.Outbox)
  bytes = text.ByteLength(json.Text(args))
  if value.Len(box) >= o.OutboxCount or list.Sum([0, list.Sum([a.Bytes for a in box])]) + bytes > o.OutboxBytes
    reply({Err: {Kind: "live", Message: "Too many actions wait to be sent: $(value.Len(box))."}})
    return missing
  end
  id = peek(screen.Next)
  put(id + 1, screen.Next)
  a = {Id: id, Key: newKey(), Name: name, Args: args, Base: base, Mine: mine, Read: read, Who: peek(screen.Who), At: sys.Now(), Bytes: bytes, Sent: false,
    Trace: if value.IsSome(screen.Tel) "00-$(text.ByteSlice(1, 32, "$(newKey())"))-$(text.ByteSlice(1, 16, newKey()))-01" else missing end, Down: not up}
  acts = peek(screen.Acts)
  acts[id] = reply
  put(acts, screen.Acts)
  put(list.Append(a, box), screen.Outbox)
  if up
    sendAct(a, screen)
  end
  status(screen)
  missing
end

defn sendAct(a, screen)
  (** An action of the outbox sent on the connection, marked sent. *)
  conn = peek(screen.Out)
  if value.IsMissing(conn)
    return missing
  end
  m = {Act: a.Name, Id: a.Id, Args: a.Args, Key: a.Key}
  if value.IsSome(a.Base)
    m.Base = a.Base
  end
  if value.IsSome(a.Who)
    m.Who = a.Who
  end
  if value.IsSome(a.Trace)
    m.Trace = a.Trace
  end
  if result.IsOk(websocket.Send(json.Text(m), conn))
    box = peek(screen.Outbox)
    put([if x.Id == a.Id dict.Put("Sent", true, x) else x end for x in box], screen.Outbox)
  end
end

defn answered(id, m, screen)
  (** Calls the function that waits for the reply id, once, and takes its action out of the outbox; a conflict joins
      the screen's Conflicts. *)
  acts = peek(screen.Acts)
  f = dict.Get(id, acts)
  if value.IsSome(f)
    put(dict.Drop(id, acts), screen.Acts)
    box = peek(screen.Outbox)
    mine = list.First([x for x in box if x.Id == id])
    put([x for x in box if x.Id != id], screen.Outbox)
    if "Err" in m and value.IsDict(m.Err) and dict.Get("Kind", m.Err) == "conflict" and value.IsSome(mine)
      Set(screen.Conflicts, list.Append({Id: id, Name: mine.Name, Args: mine.Args, Base: mine.Base, Mine: mine.Mine, Error: m.Err, Reply: f}, untracked(screen.Conflicts)))
    end
    if value.IsSome(screen.Tel) and value.IsSome(mine)
      fiber.Send({Kind: "action", Name: mine.Name, Ms: math.Round((sys.Now() - mine.At) * 1000), Ok: not ("Err" in m), Trace: mine.Trace,
        Server: dict.Get("Trace", m), Waited: mine.Down}, screen.Tel)
    end
    f(m)
    status(screen)
  end
end

defn Resolve(c, mine, screen)
  (** A conflict settled: mine true sends the action again over the values now (Keep mine), false drops it (Take
      theirs); its reply then comes to what waited for the first. *)
  Set(screen.Conflicts, [x for x in untracked(screen.Conflicts) if x.Id != c.Id])
  if mine
    now = {}
    for f in dict.GetOr("Conflict", [], c.Error)
      now[f.Field] = f.Now
    end
    actThen(c.Name, c.Args, screen, c.Reply, base = dict.Merge(if value.IsDict(c.Base) c.Base else {} end, now), mine = c.Mine)
  end
  missing
end

defn tallied(tally, rows, sign)
  (** The tally of rows with rows added (sign 1) or taken away (sign -1). *)
  t = tally
  for r in rows
    k = json.Text(r)
    n = dict.GetOr(k, {Row: r, N: 0}, t).N + sign
    t = if n > 0 dict.Put(k, {Row: r, N: n}, t) else dict.Drop(k, t) end
  end
  t
end

defn heard(m, screen)
  (** One message of the app. An {Error} ends the screen: the actions waiting stay when it asks to sign in again
      (Status 401), the others get it. *)
  if "Show" in m
    sh = showOf(m.Show, screen)
    t = if "Rows" in m tallied(dict.Dict(), m.Rows, 1) else tallied(tallied(sh.Tally, m.Added, 1), m.Removed, -1) end
    shows = peek(screen.Shows)
    shows[m.Show].Tally = t
    put(shows, screen.Shows)
    Set(sh.Signal, list.FlatMap(e -> list.Fill(e.Row, e.N), dict.Values(t)))
  else if "Ack" in m
    answered(m.Ack, m, screen)
  else if "Error" in m
    Set(screen.Error, m.Error)
    st = peek(screen.State)
    st.State = "ended"
    put(st, screen.State)
    if not (value.IsDict(m.Error) and dict.Get("Status", m.Error) == 401)
      for id in dict.Keys(peek(screen.Acts))
        answered(id, {Err: m.Error}, screen)
      end
    end
    status(screen)
  end
end

(* The value of a signal read by the screen's own work, not by a live part: no part follows it for that. An action
   asked while a page is made must not make that page follow the screen's state, or each action would make it again. *)
untracked(s) = peek(s.Cell).Value

defn status(screen)
  (** The Status signal set from the state of the connection and the outbox, when it changed. *)
  st = peek(screen.State)
  box = peek(screen.Outbox)
  v = {State: st.State, Waiting: value.Len([a for a in box if not a.Read]), Retry: st.Retry, Last: st.Last, At: st.At, Offline: st.Offline, Error: untracked(screen.Error)}
  if not value.Equal(v, untracked(screen.Status))
    Set(screen.Status, v)
  end
end

defn expire(screen)
  (** The actions that waited past OutboxWait fail: those never sent are not sent, the others may have run. *)
  old = sys.Now() - peek(screen.Settings).OutboxWait
  for a in [x for x in peek(screen.Outbox) if x.At < old]
    answered(a.Id, {Err: {Kind: "live", Message: if a.Sent "No reply came in time: the action may have run or not." else "This action waited too long to be sent: it was not sent." end}}, screen)
  end
end

defn pump(screen)
  (** Takes in what the fiber of a screen passed on since the last update: nothing to do, and nothing done, when
      nothing came and no action waits. *)
  events = drain(screen.Inbox)
  if value.Len(events) == 0 and value.Len(peek(screen.Outbox)) == 0
    return missing
  end
  for e in events
    st = peek(screen.State)
    if e.Kind == "up"
      if value.IsSome(screen.Tel)
        fiber.Send({Kind: "up", Settings: dict.Get("Telemetry", dict.GetOr("Client", {}, e))}, screen.Tel)
      end
      put(e.Conn, screen.Out)
      put(dict.Merge(defaults, dict.GetOr("Client", {}, e)), screen.Settings)
      ever = peek(screen.Ever)
      put(true, screen.Ever)
      who = dict.Get("Who", e)
      was = peek(screen.Who)
      box = peek(screen.Outbox)
      for a in box
        if value.IsSome(a.Who) and value.IsSome(was) and a.Who != who
          answered(a.Id, {Err: {Kind: "live", Message: "This action was asked by another account: it is not sent."}}, screen)
        end
      end
      put([dict.Put("Who", if value.IsMissing(a.Who) who else a.Who end, a) for a in peek(screen.Outbox)], screen.Outbox)
      put(who, screen.Who)
      st.State = "up"
      st.Retry = missing
      if ever
        st.Last = if e.Resumed "resumed" else "reloaded" end
        st.At = sys.Now()
      end
      put(st, screen.State)
      Set(screen.Up, true)
      for a in peek(screen.Outbox)
        if not e.Resumed or a.Id > e.Heard
          sendAct(a, screen)
        end
      end
    else if e.Kind == "down"
      if value.IsSome(screen.Tel)
        fiber.Send({Kind: "down"}, screen.Tel)
      end
      put(missing, screen.Out)
      Set(screen.Up, false)
      if st.State != "ended"
        st.State = "down"
        put(st, screen.State)
      end
      if peek(screen.Settings).Outbox == "off"
        for id in dict.Keys(peek(screen.Acts))
          answered(id, {Err: {Kind: "live", Message: "The connection to the app broke before it answered: the action may have run or not."}}, screen)
        end
      end
    else if e.Kind == "net"
      st.Offline = e.Offline
      put(st, screen.State)
    else if e.Kind == "wait"
      if st.State != "ended"
        st.State = "down"
        st.Retry = math.Div(math.Round(list.Max([0, e.Until - sys.Now()])), 1)
        put(st, screen.State)
      end
    else
      got = json.Parse(e.Text)
      if result.IsOk(got) and value.IsArray(got.Value)
        for m in got.Value
          if value.IsDict(m)
            heard(m, screen)
          end
        end
      end
    end
  end
  expire(screen)
  status(screen)
end

(* ---- What the page shows of its connection. *)

(* The colors of the line, as 0xRRGGBB: what is wrong, what waits, what is fine, what explains. *)
red = 0xb3261e
amber = 0x8a5a00
green = 0x1e6b2e
gray = 0x5f6670

inWords(say, t) = if value.IsMissing(say) t else say(t) end   (* A text in the page's language. *)

defn Connection(p, say = missing)
  (** The line that tells the state of the page's connection to its app, plain and in sight: Live; Connecting…;
      Offline — 2 actions waiting · next try in 4 s, with Try now; Live — sending 2 actions…; Live — back after a break,
      nothing missed (or data reloaded); Signed out — sign in again, 2 actions kept; Screen closed, with Again. say
      gives each English text filled in in the page's language, as web.App's say; missing shows the English. A page
      without a screen shows nothing. *)
  if value.IsMissing(p.Screen)
    return missing
  end
  screen = p.Screen
  () -> connectionLine(Get(screen.Status), screen, say)
end

defn connectionLine(st, screen, say)
  (** The line of a state of the connection, each of its parts said in the page's language apart, so that a catalogue
      holds a few short texts rather than each of their joins. *)
  w = st.Waiting
  sending = if w == 1 "sending 1 action…" else "sending $w actions…" end
  waits = if w == 1 "1 action waiting" else "$w actions waiting" end
  if st.State == "up"
    if w > 0
      return Text("$(inWords(say, "Live")) — $(inWords(say, sending))", color = amber)
    end
    after = if st.Last == "resumed" " — $(inWords(say, "back after a break, nothing missed"))" else if st.Last == "reloaded" " — $(inWords(say, "back after a break, data reloaded"))" else "" end
    return Text("$(inWords(say, "Live"))$after", color = green)
  end
  if st.State == "down"
    head = inWords(say, if st.Offline "Offline, no network" else "Offline" end)
    count = if w > 0 " — $(inWords(say, waits))" else "" end
    next = if value.IsNumber(st.Retry) " · $(inWords(say, "next try in $(st.Retry) s"))" else "" end
    return Row([Text("$head$count$next", color = amber), Button(inWords(say, "Try now"), () -> Again(screen))], gap = 8)
  end
  if st.State == "ended"
    e = st.Error
    if value.IsDict(e) and dict.Get("Status", e) == 401
      kept = if w > 0 ", $(inWords(say, if w == 1 "1 action kept" else "$w actions kept" end))" else "" end
      return Text("$(inWords(say, "Signed out — sign in again"))$kept", color = red)
    end
    m = if value.IsDict(e) dict.GetOr("Message", "", e) else value.Text(e) end
    return Row([Text(inWords(say, "Screen closed: $m"), color = red), Button(inWords(say, "Again"), () -> Again(screen))], gap = 8)
  end
  Text(if w > 0 "$(inWords(say, "Connecting…")) — $(inWords(say, waits))" else inWords(say, "Connecting…") end, color = gray)
end

defn Conflicts(p, say = missing)
  (** The actions of the page that the app refused because what they change changed meanwhile, each with its fields:
      the value the page saw, the value now, the page's own; Keep mine sends it again over the values now, Take theirs
      drops it. Nothing when there is none. *)
  if value.IsMissing(p.Screen)
    return missing
  end
  screen = p.Screen
  () -> conflictsOf(Get(screen.Conflicts), screen, say)
end

defn conflictsOf(cs, screen, say)
  (** The panel of the conflicts, one block each. *)
  if value.Len(cs) == 0
    return missing
  end
  Stack([conflictOf(c, screen, say) for c in cs], gap = 8, pad = 8, fill = 0xfff4e5, border = amber)
end

defn conflictOf(c, screen, say)
  (** One conflict: what was refused, a line a field, and the two choices. *)
  args = if value.IsDict(c.Mine) c.Mine else if value.IsDict(c.Args) c.Args else {} end
  fields = [fieldLine(f, args, say) for f in dict.GetOr("Conflict", [], c.Error)]
  Stack(list.Concat([Text(inWords(say, "$(c.Name) was refused: $(dict.GetOr("Message", "it changed meanwhile", c.Error))"), color = red)], list.Concat(fields,
    [Row([Button(inWords(say, "Keep mine"), () -> Resolve(c, true, screen)), Button(inWords(say, "Take theirs"), () -> Resolve(c, false, screen))], gap = 8)])), gap = 4)
end

defn fieldLine(f, args, say)
  (** A field of a conflict: its name, the value seen, the value now, and the page's own when it is known. *)
  yours = if dict.Has(f.Field, args) Text(inWords(say, "yours $(valueShown(args[f.Field]))")) else missing end
  Row([Stack([Text(f.Field, font = "strong")], width = 120), Text(inWords(say, "seen $(valueShown(f.Base))"), color = gray),
    Text(inWords(say, "now $(valueShown(f.Now))"), color = red), yours], gap = 12)
end

valueShown(v) = if value.IsMissing(v) "—" else if value.IsText(v) v else json.Text(v) end   (* A value of a field, as the panel shows it. *)
