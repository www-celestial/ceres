(* The draw list as bytes, for the glue of the browser, web/ceres.js: what it paints with WebGL2 in one pass. *)
use std/list
use std/math
use std/text
use std/value

defn Encode(items)
  (** The draw list as the bytes that web/ceres.js paints: two u32, the count of f32 numbers and the count of bytes of
      text, then the numbers, then the texts in UTF-8. Each item is a code and its numbers: 1 rect and 2 frame, X Y W
      H Color Alpha Radius; 3 text, X Y Size Color Alpha Font (0 body, 1 strong, 2 code, 3 icon) Start Length Angle, Start and
      Length the place of its text in the bytes of texts; 4 line, n Width Color Alpha then n points x y; 5 tris, n Color
      Alpha then n points; 6 a group, X Y W H Clip (1 or 0), whose items follow, up to 7, its end; and 9, a text whose
      bytes follow those of the 9 before it (the first at 0), X Y Size Color Alpha Font Length Angle, which web.Encoded
      writes. A color fits in an f32 exactly, as every integer up to 2^24 does.

        value.Len(text.Numbers("u32", text.ByteSlice(1, 8, Encode([{Kind: "rect", X: 0, Y: 0, W: 1, H: 1, Color: 0, Radius: 0}])))) --> 2 *)
  got = encoded(items, 0)
  words = text.Join("", got.Texts)
  text.Str(text.FromNumbers("u32", [got.Count, text.ByteLength(words)]), text.Join("", got.Chunks), words)
end

fonts = {body: 0, strong: 1, code: 2, icon: 3}   (* The number of each font in the bytes. *)

defn encoded(items, at, seq = false)
  (** The bytes of the numbers of items, in chunks, an item each, with their count, and the texts of items, from the
      byte at of all texts: {Chunks, Count, Texts, At}. With seq, a text is a 9, its bytes those after the text before,
      and an item that holds its own bytes (Enc, as the rows of a table keep them) gives them. *)
  chunks = []
  count = 0
  ts = []
  pos = at
  for one in items
    k = one.Kind
    if seq and "Enc" in one
      chunks = list.Append(one.Enc, chunks)
      count += math.Div(text.ByteLength(one.Enc), 4)
      if k == "text"
        ts = list.Append(one.Text, ts)
        pos += text.ByteLength(one.Text)
      end
    else
      got = item(one, k, pos, seq)
      chunks = list.Append(got.Nums, chunks)
      count += got.Count
      if k == "text"
        ts = list.Append(one.Text, ts)
        pos += text.ByteLength(one.Text)
      else if k == "group"
        ts = list.Append(got.Texts, ts)
        pos = got.At
      end
    end
  end
  {Chunks: chunks, Count: count, Texts: ts, At: pos}
end

defn item(one, k, pos, seq)
  (** The bytes of one item that holds none, with their count, and for a group the texts of its items and the byte
      after them: {Nums, Count, Texts, At}. *)
  a = dictAlpha(one)
  nums = if k == "rect" or k == "frame"
    [1 if k == "rect" else 2, one.X, one.Y, one.W, one.H, one.Color, a, radiusOf(one)]
  else if k == "text" and seq
    [9, one.X, one.Y, one.Size, one.Color, a, fonts[fontName(one)], text.ByteLength(one.Text), angleOf(one)]
  else if k == "text"
    [3, one.X, one.Y, one.Size, one.Color, a, fonts[fontName(one)], pos, text.ByteLength(one.Text), angleOf(one)]
  else if k == "line"
    list.Concat([4, value.Len(one.Points) / 2, widthOf1(one), one.Color, a], one.Points)
  else if k == "tris"
    list.Concat([5, value.Len(one.Points) / 2, one.Color, a], one.Points)
  else
    [6, one.X, one.Y, one.W, one.H, 1 if one.Clip else 0]
  end
  if k != "group"
    return {Nums: text.FromNumbers("f32", nums), Count: value.Len(nums), Texts: "", At: pos}
  end
  got = encoded(one.Items, pos, seq = seq)
  {Nums: text.Str(text.FromNumbers("f32", nums), text.Join("", got.Chunks), text.FromNumbers("f32", [7])), Count: value.Len(nums) + got.Count + 1,
    Texts: text.Join("", got.Texts), At: got.At}
end

dictAlpha(one) = one.Alpha if "Alpha" in one and value.IsSome(one.Alpha) else 255   (* The alpha of an item, 255 by default. *)
radiusOf(one) = one.Radius if "Radius" in one else 0   (* The radius of a rectangle, 0 by default. *)
fontName(one) = one.Font if "Font" in one and value.IsSome(one.Font) else "body"   (* The font of a text. *)
angleOf(one) = one.Angle if "Angle" in one else 0   (* The angle of a text. *)
widthOf1(one) = one.Width if "Width" in one and value.IsSome(one.Width) else 1   (* The width of a line. *)

defn Encoded(ui)
  (** The bytes of the page's frame, which paint what web.Encode(web.Frame(ui)) paints, made again only for the boxes
      laid out since the last frame: its texts are 9s, each after the one before, so that the bytes of a box hold no
      place of their texts, and each box keeps its bytes, in which those of its children are copied whole; the rows of
      a table keep the bytes of their items. {Ui, Bytes}: a back-end gives the Ui to the next frame. *)
  u = chunked(ui.Root, ui)
  c = u.Boxes[u.Root].Enc
  t = u.Theme
  root = u.Boxes[u.Root]
  head = encoded([rect(0, 0, u.Width, u.Height, t.Back)], 0, seq = true)
  rest = []
  seen = seenHeight(u)
  if root.H > seen
    bar = list.Max(20, math.Div(seen * seen, root.H))
    y = math.Div((seen - bar) * u.ScrollY, root.H - seen)
    rest = [rect(u.Width - 6, y, 4, bar, t.Muted)]
  end
  tail = encoded(list.Concat(list.Concat(list.Concat(rest, popupItems(u)), dropItems(u)), bandItems(u)), 0, seq = true)
  nums = text.Str(text.Join("", head.Chunks), text.FromNumbers("f32", [6, 0, -u.ScrollY, root.W, root.H, 0]), c.Nums,
    text.FromNumbers("f32", [7]), text.Join("", tail.Chunks))
  words = text.Str(text.Join("", head.Texts), c.Texts, text.Join("", tail.Texts))
  count = head.Count + 6 + c.Count + 1 + tail.Count
  {Ui: u, Bytes: text.Str(text.FromNumbers("u32", [count, text.ByteLength(words)]), nums, words)}
end

defn chunked(id, ui)
  (** The page with the bytes of the box id kept in its Enc, {Laid, Nums, Count, Texts}, made again if it was laid out
      since: its own items, then a group for each child, whose bytes are the child's. *)
  b = ui.Boxes[id]
  if value.IsSome(b.Enc) and b.Enc.Laid == b.Laid
    return ui
  end
  u = ui
  n = value.Len(b.Items)
  over = b.Over
  slots = if b.Wrap 1 else value.Len(b.Kids) end
  own = n - slots - over
  mine = encoded(if own == n b.Items else list.Take(own, b.Items) end, 0, seq = true)
  nums = [text.Join("", mine.Chunks)]
  ts = [text.Join("", mine.Texts)]
  count = mine.Count
  wrap = if b.Wrap b.Items[own + 1] else missing end
  if b.Wrap
    (* the groups of the children inside one that cuts them *)
    nums = list.Append(text.FromNumbers("f32", [6, wrap.X, wrap.Y, wrap.W, wrap.H, 1 if wrap.Clip else 0]), nums)
    count += 7
  end
  j = 0
  for c in b.Kids
    j += 1
    u = chunked(c, u)
    k = u.Boxes[c]
    e = k.Enc
    g = if b.Wrap wrap.Items[j] else b.Items[own + j] end
    nums = list.Append(text.Str(text.FromNumbers("f32", [6, g.X, g.Y, g.W, g.H, 1 if g.Clip else 0]), e.Nums, text.FromNumbers("f32", [7])), nums)
    ts = list.Append(e.Texts, ts)
    count += 6 + e.Count + 1
  end
  if b.Wrap
    nums = list.Append(text.FromNumbers("f32", [7]), nums)
  end
  if over > 0
    after = encoded(list.Skip(n - over, b.Items), 0, seq = true)
    nums = list.Append(text.Join("", after.Chunks), nums)
    ts = list.Append(text.Join("", after.Texts), ts)
    count += after.Count
  end
  u.Boxes[id].Enc = {Laid: b.Laid, Nums: text.Join("", nums), Count: count, Texts: text.Join("", ts)}
  u
end
