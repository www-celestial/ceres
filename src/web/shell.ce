(* The layout of a web app, Pages: the app's pages in a side bar at the left, in groups with their counts; a top bar
   with where one is and the tools of the window (search, density, theme); the page in the middle, which scrolls by
   itself and keeps its place for each view; the details of a thing in a sheet at the right, beside the page on a wide
   window (1280 pixels and more), over it on a narrower one, the whole window on a phone (under 760 pixels), where the
   side bar is a drawer that the menu button opens. Ctrl+K opens the palette, which finds a page or an action by its
   name. The parts of a page in it: web.Header, web.Chips, web.Pill, web.Bulk, web.Sheet, web.Asked, web.Strip,
   web.Metric, web.Steps. These widgets carry the kit of dock.ce, as those of a desktop tool do: a page that makes none
   of them holds none of their code. *)
use std/dict
use std/fiber
use std/json
use std/list
use std/math
use std/text
use std/value

phoneWidth = 760   (* Under this width a window is a phone's: the side bar is a drawer, a sheet the whole window. *)
wideWidth = 1280   (* From this width a sheet stands beside the page rather than over it. *)

sizesOf(t) = if value.IsDict(dict.Get("Sizes", t)) t.Sizes else Densities.compact end   (* The sizes of a theme's density. *)
said1(say, t) = if value.IsMissing(say) t else say(t) end   (* One of the shell's own texts in the app's language. *)

(* ---- Constructors *)

defn Shell(p, page, side = [], top = [], sheet = missing, find = missing, view = missing, label = "", say = missing)
  (** The layout of a web app, which fills the window: side, the widgets of the side bar one under the other (the
      app's name, a web.Nav of its pages, and after a web.Spacer() what stands at its foot, as who is signed in); top,
      those of the top bar at its left, as where one is (a path of links); page, the page shown, which scrolls by
      itself; sheet, a function that gives the details of the thing chosen (a web.Sheet) or missing, shown at the
      right. find, a function that gives the commands of the app (web.Command), makes the palette that Ctrl+K opens,
      and a field of search in the side bar. view, a function that gives the name of the view shown (the page's path
      without the thing opened in the sheet, as "/data/invoice" for "/data/invoice/65691"), keeps the scroll of each
      view; the path by default. The top bar holds at its right a button for the density of the rows (web.Densities),
      which goes round them, and one for the theme, each kept on the machine (web.SetLook). say gives the shell's own
      English texts in the app's language. A route of the app gives the same shell each time (made once and kept, as
      a web.Dock), so that it stays mounted from page to page.

        Shell({Path: "/"}, Text("Hello")).Kind --> "shell" *)
  st = {Id: fresh(), Drawer: Signal(false), Find: Signal(false), Query: Signal(""), Pick: Signal(1), Entries: find,
    Scrolls: cell(dict.Dict()), View: cell(missing), Opened: cell(false), P: p, Say: say}
  menu = {Kind: "narrow", Kids: [IconButton("menu", said1(say, "Menu"), () -> Set(st.Drawer, not nowOf(st.Drawer)))], Kit: kit}
  tools = [if value.IsSome(find) IconButton("search", said1(say, "Search"), () -> openFind(st), key = "C-k") else missing end,
    () -> densityButton(p, say), () -> themeButton(p, say)]
  bar = Row(list.Concat(list.Concat([menu], top), list.Prepend(Spacer(), tools)), gap = 4)
  sides = if value.IsSome(find) and not value.IsEmpty(side) list.Concat([side[1], findField(st, say)], list.Skip(1, side)) else side end
  {Kind: "shell", State: st, View: view, Label: label, Kit: kit,
    Kids: [{Kind: "side", Kids: [Scroll(Stack(sides, gap = 10, pad = 10))], State: st, Kit: kit}, bar, Scroll({Kind: "inset", Kids: [kid(page)], Kit: kit}),
      {Kind: "live", Fn: () -> sheetPart(sheet)}, {Kind: "live", Fn: () -> findPart(st)}]}
end

sheetPart(sheet) = if value.IsMissing(sheet) missing else sheet() end   (* The sheet shown, or nothing. *)

defn findField(st, say)
  (** The field of search at the top of the side bar: it opens the palette, as Ctrl+K does. *)
  Button(said1(say, "Search"), () -> openFind(st), key = "C-k", icon = "search", style = "field")
end

defn openFind(st)
  (** Opens the palette, empty, its first command chosen. *)
  Set(st.Query, "")
  Set(st.Pick, 1)
  Set(st.Find, true)
  Set(st.Drawer, false)
end

defn densityButton(p, say)
  (** The button of the top bar that goes round the densities, from dense to comfortable. *)
  now = LookOf(p).Density
  next = if now == "dense" "compact" else if now == "compact" "comfortable" else "dense" end
  IconButton("rows-2", "$(said1(say, "Density")): $(said1(say, now))", () -> SetLook(p, density = next))
end

defn themeButton(p, say)
  (** The button of the top bar that turns the theme dark or light: a sun in the dark, a moon in the light. *)
  now = LookOf(p).Theme
  other = if now == "dark" "light" else "dark" end
  IconButton(if now == "dark" "sun" else if now == "light" "moon" else "sun-moon" end, said1(say, "Theme"), () -> SetLook(p, theme = other))
end

defn Nav(groups, label = "")
  (** The pages of an app in its side bar: groups (web.Group) of rows (web.Item, each with to, its route), a list or
      a function that gives one, read again as it changes (its counts). The row of the route shown is chosen, as the
      row whose route is the longest start of it ("/data/invoice" for "/data/invoice/65691"); a click goes to a row's
      route, and in a browser Ctrl or the middle button opens it in a new tab. Up and Down move along the rows while it
      has the focus, Enter goes. label names it for a screen reader.

        Nav([Group("Data", [Item("Invoices", to = "/invoices")])]).Kind --> "nav" *)
  {Kind: "nav", Groups: groups, Label: label, Cursor: Signal(0), Kit: kit}
end

(** A group of rows of a web.Nav under its title, in small capitals; "" for rows with no title, as the first.

      Group("Data", []).Title --> "Data" *)
Group(title, items) = {Title: title, Items: items}

defn Command(label, to = missing, on = missing, group = "", icon = missing, key = missing)
  (** A command of the palette of a web.Shell: its label, what it finds it by; to, a route it goes to, or on(), what
      it does; group, the title it is listed under ("Pages", "Actions"); icon, a name of web.Icons; key, its key, shown
      at its right.

        Command("Users", to = "/users", group = "Pages").To --> "/users" *)
  {Label: label, To: to, On: on, Group: group, Icon: icon, Key: key}
end

defn Header(title, summary = missing, actions = [])
  (** The head of a page: its title, a summary beside it in the muted color ("30 invoices · 20,563.64 € to collect"),
      a text or a function, and its actions at the right, buttons (one web.Button(style = "primary") at most). On a
      narrow window the actions go under the title.

        Header("Invoices").Kind --> "header" *)
  left = Row([Title(title), if value.IsMissing(summary) missing else Text(summary, size = "small", color = "Muted") end], gap = 10, align = "end")
  {Kind: "header", Kids: [left, Row(actions, gap = 8)], Kit: kit}
end

defn Spread(left, right, grow = false)
  (** Two parts of a line: left at its left, right at its right, as the chips of a table and its search; right goes
      under left when both don't fit, as on a phone. Each is a widget or a list of them. With grow, right takes the
      width that left leaves (a column of titles and one of settings), and goes under it when that is under 320
      pixels.

        Spread(Text("a"), Text("b")).Kind --> "header" *)
  {Kind: "header", Grows: grow, Kids: [if value.IsArray(left) Row(left, gap = 8) else kid(left) end, if value.IsArray(right) Row(right, gap = 8) else kid(right) end], Kit: kit}
end

defn Wide(item)
  (** A part shown only on a window of 760 pixels and more: on a phone it takes no room, as the start of a path of
      crumbs in a top bar.

        Wide(Text("Data")).Kind --> "narrow" *)
  {Kind: "narrow", Kids: [kid(item)], Wide: true, Kit: kit}
end

defn Chips(v, options, label = "")
  (** A choice among a few, side by side, as the states of the rows of a table with their counts (All 30, Draft 2,
      Unpaid 9): v, a signal of the key of the one chosen; options, a list of web.Chip, or a function that gives one,
      read again as it changes. A click chooses one, and so do Left and Right while it has the focus. label names it for
      a screen reader.

        Chips(Signal("all"), [Chip("all", "All")]).Kind --> "chips" *)
  {Kind: "chips", Value: v, Options: options, Label: label, Kit: kit}
end

(** A choice of web.Chips: its key, its label, and a count shown after it, or missing.

      Chip("paid", "Paid", count = 14).Count --> 14 *)
Chip(key, label, count = missing) = {Key: key, Label: label, Count: count}

defn Bulk(checks, actions, say = missing)
  (** What can be done to the rows checked in a web.Table (its checks): a band that says how many are, the actions
      (buttons), and one that checks none again; nothing while none is checked. checks is the table's signal.

        value.IsFunction(Bulk(Signal({}), [])) --> true *)
  () -> bulkOf(Get(checks), checks, actions, say)
end

defn bulkOf(chosen, checks, actions, say)
  (** The band of web.Bulk for the keys checked. *)
  n = value.Len(chosen)
  if n == 0
    return missing
  end
  Row(list.Concat([Text("$n $(said1(say, "selected"))", color = "Link")], list.Concat([Spacer()], list.Append(Button(said1(say, "Clear"), () -> Set(checks, dict.Dict()), style = "ghost"), actions))),
    gap = 8, pad = 6, fill = "Soft", radius = 4)
end

defn Sheet(title, body, close = missing, kicker = missing, sub = missing, tag = missing, tools = [], foot = [], say = missing)
  (** The details of a thing, in the sheet at the right of a web.Shell: kicker, a small line above its title (the
      kind and the id); title; tag, a web.Pill beside it; sub, a line under it; tools, buttons at its top right before
      the one that closes it (close(), which Esc runs too); body, its fields, which scroll; foot, the buttons at its
      foot, as Cancel and Save. A view left with changes not saved asks here, in a band under its title (web.Asked).

        Sheet("1027", Text("…")).Kind --> "sheet" *)
  closer = if value.IsMissing(close) [] else [IconButton("x", said1(say, "Close"), close)] end
  head = Row([Grow(Stack([if value.IsMissing(kicker) missing else Text(kicker, size = "small", color = "Muted") end,
      Row([Text(title, size = "title", font = "strong"), tag], gap = 10), if value.IsMissing(sub) missing else Text(sub, color = "Muted") end], gap = 2)),
    Row(list.Concat(tools, closer), gap = 2)], gap = 8, pad = 12, align = "start")
  parts = [head, Divider(), Asked(say = say), Grow(Scroll(Stack([body], pad = 16))), if value.IsEmpty(foot) missing else Divider() end,
    if value.IsEmpty(foot) missing else Row(foot, gap = 8, pad = 10) end]
  {Kind: "sheet", Close: close, Kids: [Stack(parts, gap = 0)], Kit: kit}
end

(** Where a view left with changes not saved (web.Unsaved) asks what to do with them, inline: a band in the color of
    warnings with Keep editing, Discard changes and Save and leave, rather than the band at the bottom of the window.
    Nothing while nothing asks. A web.Sheet holds one under its title.

      Asked().Kind --> "asked" *)
Asked(say = missing) = {Kind: "asked", Say: say, Kit: kit}

defn Strip(items)
  (** A line of states at the top of a dashboard, each in its cell, a thin line between two: widgets, as a text with a
      dot of web.Pill's or a web.Link; the cells go on a second line when the window is narrow.

        Strip(["Live"]).Kind --> "strip" *)
  {Kind: "strip", Kids: kids(items), Kit: kit}
end

defn Metric(title, figure, series, unit = "", note = "", at = missing, cross = missing, style = "area", most = missing, label = "")
  (** A graph of a dashboard, small, on its card: its title; figure(i), its number, at the point i under the
      crosshair, or the last for missing; unit beside it and note at the right, muted; series, a function that gives
      the lines: [{Values, Tone}], the values one a point, Tone a slot of the charts ("S1" to "S5") or a role ("Warn",
      "Danger", "Ok"); style "area" (the first line filled under), "line", or "bars", stacked; most, the top of its
      scale (the largest value made round by default); at(i), the time of the point i, for the readout and the axis.
      cross, a signal shared by the graphs of a board: the mouse over one draws the crosshair at that point in all of
      them, each with its value there. label names it for a screen reader.

        Metric("Requests", i -> "312", () -> []).Kind --> "metric" *)
  {Kind: "metric", Title: title, Figure: figure, Series: series, Unit: unit, Note: note, At: at, Cross: cross, Style: style, Most: most, Label: if label == "" title else label end, Kit: kit}
end

defn Steps(steps, say = missing)
  (** The first steps of an app that has nothing yet, as a list to check: steps [{Title, About, Done, Action}], Done
      true for a step done, Action a button that does it. A bar above says how many are done.

        Steps([{Title: "Add a user", About: "…", Done: false, Action: missing}]).Kind --> "stack" *)
  done = value.Len([s for s in steps if s.Done])
  all = value.Len(steps)
  bar = Row([Grow(Stack([], height = 6, fill = "Ok", radius = 3), share = list.Max(1, done)), if done < all Grow(Spacer(), share = all - done) else missing end], gap = 0, fill = "Header", radius = 3, height = 6)
  rows = [stepRow(k, steps[k]) for k in 1..all]
  Stack(list.Concat([Text("$done / $all $(said1(say, "done"))", size = "small", color = "Muted"), if done == 0 Row([], height = 6, fill = "Header", radius = 3) else bar end], rows), gap = 10)
end

defn stepRow(k, s)
  (** A step of web.Steps: its number in a circle, or a check once done; its title and what it is about; its action. *)
  mark = if s.Done Icon("circle-check", color = "Ok") else Text("$k", font = "strong", color = "Muted") end
  Row([Stack([mark], width = 24, align = "center"), Grow(Stack([Text(s.Title, font = "strong", color = if s.Done "Muted" else missing end), Text(s.About, color = "Muted")], gap = 2)),
    if s.Done or value.IsMissing(dict.Get("Action", s)) missing else s.Action end], gap = 12)
end

(* ---- Layout *)

defn layShell(id, maxW, ui)
  (** The side bar, the top bar, the page, the sheet and the palette, placed for the width of the window; the toast
      over all of them. *)
  b = ui.Boxes[id]
  n = b.Node
  st = n.State
  got = watched(id, () -> {Drawer: Get(st.Drawer), Toast: if value.IsSome(ui.Router) Get(ui.Router.Toast) else missing end,
    View: if value.IsFunction(n.View) n.View() else if value.IsSome(ui.Nav) Get(ui.Nav) else "/" end}, ui)
  u = got.Ui
  u.Shell = id
  t = u.Theme
  z = sizesOf(t)
  w = maxW
  h = if value.IsSome(b.Gh) b.Gh else seenHeight(u) end
  ks = if value.IsArray(dict.Get("Order", b)) b.Order else b.Kids end
  u.Boxes[id].Order = ks
  side = ks[1]
  bar = ks[2]
  pg = ks[3]
  sh = ks[4]
  fd = ks[5]
  (* the scroll of the page, kept for each view *)
  view = got.Value.View
  was = peek(st.View)
  if was != view
    sc = u.Boxes[pg].Node
    if value.IsSome(was)
      put(dict.Put(was, nowOf(sc.Offset), peek(st.Scrolls)), st.Scrolls)
    end
    quiet(sc.Offset, dict.GetOr(view, 0, peek(st.Scrolls)))
    put(view, st.View)
    u = touch(pg, u)
  end
  phone = w < phoneWidth
  drawer = phone and got.Value.Drawer
  sheetKid = u.Boxes[sh].Kids
  shown = not value.IsEmpty(sheetKid) and u.Boxes[sheetKid[1]].Node.Kind == "sheet"
  sideW = if phone 0 else z.Side end
  drawerW = list.Min(300, math.Div(w * 86, 100))
  sheetW = if phone w else list.Min(z.Sheet, w) end
  mode = if not shown "none" else if phone "full" else if w >= wideWidth "beside" else "over" end
  if dict.Get("ShellMode", u) != mode
    u.ShellMode = mode
    if shown
      u = touch(sheetKid[1], u)
    end
  end
  mainW = w - sideW - (sheetW if mode == "beside" else 0)
  top = z.Top
  if not peek(st.Opened) and nowOf(st.Find)
    (* the palette just opened: the focus in its field, before it is laid out *)
    put(true, st.Opened)
    field = firstOf(fd, "input", u)
    if field != 0
      u = focus(field, u)
    end
  else if peek(st.Opened) and not nowOf(st.Find)
    put(false, st.Opened)
  end
  px = if phone 10 else z.Px end
  u = layout(side, drawerW if phone else sideW, false, u, h = h)
  u = place(side, 0 if not phone or drawer else -drawerW - 40, 0, u)
  u = layout(bar, mainW - px - 10, false, u)
  u = place(bar, sideW + px, math.Div(top - u.Boxes[bar].H, 2), u)
  u = layout(pg, mainW, false, u, h = h - top)
  u = place(pg, sideW, top, u)
  u = layout(sh, sheetW, false, u, h = h)
  u = place(sh, w - sheetW, 0, u)
  pw = list.Min(580, w - 32)
  u = layout(fd, pw, false, u, h = h)
  u = place(fd, math.Div(w - pw, 2), list.Max(16, math.Div(h * 12, 100)), u)
  order = if drawer [bar, pg, sh, side, fd] else [side, bar, pg, sh, fd] end
  u.Boxes[id].Kids = order
  k = dict.Get("Tokens", t)
  ground = if value.IsDict(k) k.Ground else t.Back end
  panel = if value.IsDict(k) k.Panel else role("Panel", t) end
  line = if value.IsDict(k) k.Divider else role("Edge", t) end
  own = [rect(0, 0, w, h, ground), rect(sideW, 0, mainW, top, panel), rect(sideW, top - 1, mainW, 1, line)]
  clips = dict.Dict()
  clips[side] = not drawer
  clips[bar] = true
  clips[pg] = true
  clips[sh] = false
  clips[fd] = false
  groups = [group(u.Boxes[c].X, u.Boxes[c].Y, u.Boxes[c].W, u.Boxes[c].H, clips[c], u.Boxes[c].Items) for c in order]
  toast = toastItems(got.Value.Toast, w, h, t, u)
  boxed(id, w, h, list.Concat(list.Concat(own, groups), toast), {Phone: phone, Drawer: drawer, DrawerW: drawerW, Mode: mode, Toast: got.Value.Toast,
    SheetW: sheetW, Top: top}, u, over = value.Len(toast))
end

defn firstOf(id, kind, u)
  (** The first box of a kind at id or under it, or 0. *)
  if u.Boxes[id].Node.Kind == kind
    return id
  end
  for c in u.Boxes[id].Kids
    got = firstOf(c, kind, u)
    return got if got != 0
  end
  0
end

defn toastItems(toast, w, h, t, u)
  (** The toast at the bottom of the window: a short text on a dark pill (light in the dark theme), a check before. *)
  if value.IsMissing(toast)
    return []
  end
  s = toast.Text
  tw = widthOf(s, t.Size, "body", u)
  bw = list.Min(w - 32, tw + 46)
  bh = 40
  x = math.Div(w - bw, 2)
  y = h - bh - 20
  k = dict.Get("Tokens", t)
  back = if value.IsDict(k) k.FgStrong else t.Ink end
  ink = if value.IsDict(k) k.Ground else t.Paper end
  [{Kind: "rect", X: x, Y: y + 4, W: bw, H: bh, Color: 0x000000, Radius: 6, Alpha: 50}, rect(x, y, bw, bh, back, 6),
    iconItem(x + 14, y + math.Div(bh - 16, 2), "circle-check", 16, if value.IsDict(k) k.Ok else t.Accent end),
    group(x + 38, 0, bw - 46, h, true, [words(0, y + math.Div(bh - lineOf(t.Size, u), 2), s, t.Size, ink)])]
end

defn laySide(id, maxW, ui)
  (** The side bar: its panel, a line at its right, what it holds, which scrolls; as a drawer, a veil over the rest
      of the window, which a click on closes it. *)
  b = ui.Boxes[id]
  n = b.Node
  got = watched(id, () -> Get(n.State.Drawer), ui)
  u = got.Ui
  t = u.Theme
  h = if value.IsSome(b.Gh) b.Gh else seenHeight(u) end
  c = b.Kids[1]
  u = layout(c, maxW - 1, false, u, h = h)
  u = place(c, 0, 0, u)
  k = dict.Get("Tokens", t)
  out = []
  if got.Value and u.Width < phoneWidth
    out = [{Kind: "rect", X: maxW, Y: 0, W: u.Width, H: h, Color: 0x000000, Radius: 0, Alpha: 140}, {Kind: "rect", X: maxW, Y: 0, W: 12, H: h, Color: 0x000000, Radius: 0, Alpha: 60}]
  end
  out = list.Concat(out, [rect(0, 0, maxW, h, if value.IsDict(k) k.Panel else role("Panel", t) end), rect(maxW - 1, 0, 1, h, if value.IsDict(k) k.Divider else role("Edge", t) end)])
  sized(id, maxW, h, list.Append(group(0, 0, maxW - 1, h, true, u.Boxes[c].Items), out), u)
end

defn layInset(id, maxW, ui)
  (** The page in its margins, which the density sets: its child, and a space under it. *)
  b = ui.Boxes[id]
  t = ui.Theme
  z = sizesOf(t)
  phone = ui.Width < phoneWidth
  px = if phone 12 else z.Px end
  py = if phone 12 else z.Py end
  c = b.Kids[1]
  u = layout(c, list.Max(40, maxW - 2 * px), false, ui)
  u = place(c, px, py, u)
  hh = u.Boxes[c].H + py + 40
  sized(id, maxW, hh, kidGroups(u.Boxes[id], u), u)
end

defn layNarrow(id, maxW, ui)
  (** A part shown only on a phone, as the menu button: nothing on a wider window. *)
  b = ui.Boxes[id]
  c = b.Kids[1]
  u = layout(c, maxW, true, ui)
  u = place(c, 0, 0, u)
  if (ui.Width >= phoneWidth) != dict.GetOr("Wide", false, b.Node)
    return sized(id, 0, 0, [group(0, 0, 0, 0, true, u.Boxes[c].Items)], u)
  end
  sized(id, u.Boxes[c].W, u.Boxes[c].H, kidGroups(u.Boxes[id], u), u)
end

defn laySheet(id, maxW, ui)
  (** The sheet: its panel, a line at its left, its shadow over the page when it stands over it, what it holds. *)
  b = ui.Boxes[id]
  t = ui.Theme
  h = if value.IsSome(b.Gh) b.Gh else seenHeight(ui) end
  c = b.Kids[1]
  u = layout(c, maxW - 1, false, ui, h = h)
  u = place(c, 1, 0, u)
  k = dict.Get("Tokens", t)
  over = dict.GetOr("ShellMode", "beside", u) == "over"
  shade = if over [{Kind: "rect", X: -24, Y: 0, W: 24, H: h, Color: 0x000000, Radius: 0, Alpha: 18}, {Kind: "rect", X: -12, Y: 0, W: 12, H: h, Color: 0x000000, Radius: 0, Alpha: 30},
    {Kind: "rect", X: -4, Y: 0, W: 4, H: h, Color: 0x000000, Radius: 0, Alpha: 46}] else [] end
  own = list.Concat(shade, [rect(0, 0, maxW, h, if value.IsDict(k) k.Panel else role("Panel", t) end), rect(0, 0, 1, h, if value.IsDict(k) k.Divider else role("Edge", t) end)])
  sized(id, maxW, h, list.Append(group(1, 0, maxW - 1, h, true, u.Boxes[c].Items), own), u)
end

defn findPart(st)
  (** The palette while it is open: its field, the commands found, and its keys. *)
  if not Get(st.Find)
    return missing
  end
  say = st.Say
  keys = Row([keyText("↑ ↓", said1(say, "move")), keyText("Enter", said1(say, "open")), keyText("Esc", said1(say, "close"))], gap = 14, pad = 8)
  {Kind: "pop", Kids: [Stack([Row([Icon("search", color = "Muted"), Grow(Input(st.Query, label = said1(say, "Search"), placeholder = said1(say, "Search pages and actions"), width = 100000))], gap = 8, pad = 10),
    Divider(), {Kind: "picks", State: st, Kit: kit}, Divider(), keys], gap = 0)], Kit: kit}
end

keyText(k, what) = Row([Text(k, size = "small", font = "strong", color = "Muted"), Text(what, size = "small", color = "Muted")], gap = 4)   (* A key and what it does. *)

defn layPop(id, maxW, ui)
  (** The palette's box over a veil that covers the window. *)
  b = ui.Boxes[id]
  t = ui.Theme
  c = b.Kids[1]
  u = layout(c, maxW, false, ui)
  u = place(c, 0, 0, u)
  h = u.Boxes[c].H
  k = dict.Get("Tokens", t)
  veil = {Kind: "rect", X: -4000, Y: -4000, W: 12000, H: 12000, Color: 0x000000, Radius: 0, Alpha: 120}
  own = [veil, {Kind: "rect", X: 0, Y: 6, W: maxW, H: h, Color: 0x000000, Radius: 10, Alpha: 70}, rect(0, 0, maxW, h, if value.IsDict(k) k.Panel else role("Panel", t) end, 10),
    frame(0, 0, maxW, h, if value.IsDict(k) k.DropdownLine else role("Edge", t) end, 10)]
  sized(id, maxW, h, list.Append(group(0, 0, maxW, h, true, u.Boxes[c].Items), own), u)
end

defn matching(st)
  (** The commands of the palette that its text finds: those whose label holds it, those that start with it first;
      the first ten while it is empty. At most twelve. *)
  all = if value.IsFunction(st.Entries) st.Entries() else [] end
  q = text.Lower(text.Trim(Get(st.Query)))
  if q == ""
    return list.Take(10, all)
  end
  starts = [e for e in all if text.StartsWith(q, text.Lower(e.Label))]
  holds = [e for e in all if not text.StartsWith(q, text.Lower(e.Label)) and (text.Contains(q, text.Lower(e.Label)) or text.Contains(q, text.Lower(dict.GetOr("Group", "", e))))]
  list.Take(12, list.Concat(starts, holds))
end

defn layPicks(id, maxW, ui)
  (** The commands found, each on its row under its group's title: its icon, its label, its key or its group at its
      right; the one chosen lit. *)
  b = ui.Boxes[id]
  st = b.Node.State
  got = watched(id, () -> {Found: matching(st), Pick: Get(st.Pick)}, ui)
  u = got.Ui
  t = u.Theme
  k = dict.Get("Tokens", t)
  found = got.Value.Found
  rh = t.Field + 8
  lh = lineOf(t.Size, u)
  small = t.Size - 1.5
  items = []
  rows = []
  y = 6
  group0 = missing
  for i in 1..value.Len(found)
    e = found[i]
    g = dict.GetOr("Group", "", e)
    if g != "" and g != group0
      items = list.Append(words(14, y + 4, text.Upper(g), small - 0.5, t.Muted, "strong"), items)
      y += lineOf(small, u) + 8
    end
    group0 = g
    on = i == got.Value.Pick
    if on
      items = list.Append(rect(6, y, maxW - 12, rh, if value.IsDict(k) k.Header else role("Hover", t) end, 4), items)
    end
    x = 16
    if value.IsSome(dict.Get("Icon", e))
      items = list.Append(iconItem(x, y + math.Div(rh - 16, 2), e.Icon, 16, if value.IsDict(k) k.Icon else t.Muted end), items)
      x += 26
    end
    items = list.Append(words(x, y + math.Div(rh - lh, 2), e.Label, t.Size, role("Strong", t) if on and value.IsDict(k) else t.Ink), items)
    if value.IsSome(dict.Get("Key", e))
      s = keyName(e.Key)
      items = list.Append(words(maxW - 16 - widthOf(s, small, "body", u), y + math.Div(rh - lineOf(small, u), 2), s, small, t.Muted), items)
    end
    rows = list.Append({Y: y, H: rh, I: i}, rows)
    y += rh
  end
  if value.IsEmpty(found)
    items = [words(16, y + 8, "—", t.Size, t.Muted)]
    y += lh + 16
  end
  cached(id, maxW, y + 6, items, {Rows: rows, Found: found, Text: ""}, u)
end

defn pickFind(st)
  (** Runs the command chosen in the palette, which closes: goes to its route, or does what it does. *)
  found = matching(st)
  if value.IsEmpty(found)
    return missing
  end
  e = found[list.Max(1, list.Min(value.Len(found), nowOf(st.Pick)))]
  Set(st.Find, false)
  Set(st.Query, "")
  if value.IsSome(dict.Get("To", e))
    Go(e.To, st.P)
  else if value.IsFunction(dict.Get("On", e))
    e.On()
  end
  missing
end

defn navRows(groups, path)
  (** The rows of a nav: {Head} for a group's title, {Item} for a row, and the key of the row chosen, the one whose
      route is the longest start of path: {Rows, Chosen}. *)
  rows = []
  best = missing
  bestLen = 0
  for g in groups
    if g.Title != ""
      rows = list.Append({Head: g.Title, Item: missing}, rows)
    end
    for one in g.Items
      rows = list.Append({Head: missing, Item: one}, rows)
      to = dict.Get("To", one)
      if value.IsText(to) and value.IsText(path) and (to == path or to != "/" and text.StartsWith("$to/", path) or to != "/" and text.StartsWith("$to?", path)) and value.Len(to) > bestLen
        best = one.Key
        bestLen = value.Len(to)
      end
    end
  end
  {Rows: rows, Chosen: best}
end

defn layNav(id, maxW, ui)
  (** The rows of a nav: the groups' titles small, muted and in capitals, a space above each; a row with its icon,
      its label and its count at its right, the row chosen in the color of the choice, the row under the mouse lit. *)
  b = ui.Boxes[id]
  n = b.Node
  got = watched(id, () -> navRows(if value.IsFunction(n.Groups) n.Groups() else n.Groups end, if value.IsSome(ui.Nav) Get(ui.Nav) else missing end), ui)
  u = got.Ui
  t = u.Theme
  k = dict.Get("Tokens", t)
  z = sizesOf(t)
  rh = z.Nav
  lh = lineOf(t.Size, u)
  small = t.Size - 1.5
  sl = lineOf(small, u)
  cursor = nowOf(n.Cursor)
  items = []
  spots = []
  y = 0
  j = 0
  for r in got.Value.Rows
    if value.IsSome(r.Head)
      if y > 0
        y += 8
      end
      items = list.Append(words(6, y, text.Upper(r.Head), small - 0.5, t.Muted, "strong"), items)
      y += sl + 2
    else
      j += 1
      one = r.Item
      on = one.Key == got.Value.Chosen
      hot = u.Hover == id and u.HoverPart == j
      if on
        items = list.Append(rect(0, y, maxW, rh, t.Chosen, 4), items)
      else if hot
        rh2 = if value.IsDict(k) k.RowHover else [t.Ink, 20] end
        items = list.Append({Kind: "rect", X: 0, Y: y, W: maxW, H: rh, Color: rh2[1], Radius: 4, Alpha: rh2[2]}, items)
      end
      ink = if on t.ChosenInk else if hot role("Strong", t) else if value.IsDict(k) k.Icon else t.Ink end
      x = 6
      if value.IsSome(one.Icon)
        items = list.Append(iconItem(x, y + math.Div(rh - 16, 2), one.Icon, 16, ink), items)
        x += 24
      end
      items = list.Append(words(x, y + math.Div(rh - lh, 2), shown(one.Label), t.Size, if on t.ChosenInk else if hot role("Strong", t) else t.Ink end), items)
      if value.IsSome(one.Count)
        s = shown(one.Count)
        tn = dict.Get("Tone", one)
        cc = if on t.ChosenInk else if value.IsSome(tn) tone(tn, t) else t.Muted end
        items = list.Append(words(maxW - 6 - widthOf(s, small, if value.IsSome(tn) "strong" else "body" end, u), y + math.Div(rh - sl, 2), s, small, cc, if value.IsSome(tn) "strong" else "body" end), items)
      end
      if u.Focus == id and u.Ring and (cursor == j or cursor == 0 and on)
        items = list.Concat(items, [moved1(one1, 0, y) for one1 in ringItems(maxW, rh, t)])
      end
      spots = list.Append({Y: y, H: rh, Item: one, On: on}, spots)
      y += rh + 1
    end
  end
  cached(id, maxW, list.Max(rh, y), items, {Spots: spots, Text: n.Label, Chosen: got.Value.Chosen}, u)
end

defn layHeader(id, maxW, ui)
  (** The title and the summary at the left, the actions at the right; the actions under them when both don't fit. *)
  b = ui.Boxes[id]
  l = b.Kids[1]
  r = b.Kids[2]
  if dict.GetOr("Grows", false, b.Node)
    u = layout(l, maxW, true, ui)
    lw = u.Boxes[l].W
    if maxW - lw - 24 >= 320
      u = layout(r, maxW - lw - 24, false, u)
      u = place(l, 0, 0, u)
      u = place(r, lw + 24, 0, u)
      return sized(id, maxW, list.Max(u.Boxes[l].H, u.Boxes[r].H), kidGroups(u.Boxes[id], u), u)
    end
    u = layout(r, maxW, false, u)
    u = place(l, 0, 0, u)
    u = place(r, 0, u.Boxes[l].H + 12, u)
    return sized(id, maxW, u.Boxes[l].H + 12 + u.Boxes[r].H, kidGroups(u.Boxes[id], u), u)
  end
  u = layout(r, maxW, true, ui)
  u = layout(l, maxW, true, u)
  lw = u.Boxes[l].W
  rw = u.Boxes[r].W
  lh = u.Boxes[l].H
  rh = u.Boxes[r].H
  if lw + rw + 16 <= maxW
    hh = list.Max(lh, rh)
    u = place(l, 0, math.Div(hh - lh, 2), u)
    u = place(r, maxW - rw, math.Div(hh - rh, 2), u)
    return sized(id, maxW, hh, kidGroups(u.Boxes[id], u), u)
  end
  u = place(l, 0, 0, u)
  u = place(r, 0, lh + 8, u)
  sized(id, maxW, lh + 8 + rh, kidGroups(u.Boxes[id], u), u)
end

defn layChips(id, maxW, ui)
  (** The chips side by side in their well, the one chosen raised; each its label and its count. *)
  b = ui.Boxes[id]
  n = b.Node
  got = watched(id, () -> {Options: if value.IsFunction(n.Options) n.Options() else n.Options end, Now: Get(n.Value)}, ui)
  u = got.Ui
  t = u.Theme
  k = dict.Get("Tokens", t)
  h = t.Field
  ch = h - 4
  lh = lineOf(t.Size, u)
  small = t.Size - 1.5
  items = [rect(0, 0, 10, h, if value.IsDict(k) k.Input else t.Paper end, 4)]
  spans = []
  x = 2
  for i in 1..value.Len(got.Value.Options)
    o = got.Value.Options[i]
    label = shown(o.Label)
    cs = if value.IsMissing(o.Count) "" else shown(o.Count) end
    lw = widthOf(label, t.Size, "body", u)
    cw = if cs == "" 0 else widthOf(cs, small, "body", u) + 6 end
    w = lw + cw + 18
    on = o.Key == got.Value.Now
    hot = u.Hover == id and u.HoverPart == i
    if on
      items = list.Append(rect(x, 2, w, ch, if value.IsDict(k) k.Dropdown else t.Chosen end, 3), items)
    end
    ink = if on role("Strong", t) if value.IsDict(k) else t.ChosenInk else if hot role("Strong", t) if value.IsDict(k) else t.Ink else if value.IsDict(k) k.Icon else t.Ink end
    items = list.Append(words(x + 9, math.Div(h - lh, 2), label, t.Size, ink), items)
    if cs != ""
      items = list.Append(words(x + 9 + lw + 6, math.Div(h - lineOf(small, u), 2), cs, small, t.Muted), items)
    end
    if on and u.Focus == id and u.Ring
      items = list.Concat(items, [moved1(r, x, 2) for r in ringItems(w, ch, t, r = 3)])
    end
    spans = list.Append([x, w, o.Key, label], spans)
    x += w + 2
  end
  w = x
  items[1] = rect(0, 0, w, h, if value.IsDict(k) k.Input else t.Paper end, 4)
  items = list.Append(frame(0, 0, w, h, if value.IsDict(k) k.InputLine else t.Line end, 4), items)
  cached(id, w, h, items, {Spans: spans, Text: n.Label, Now: got.Value.Now}, u)
end

defn layPill(id, ui)
  (** A pill on its own: its word in its color. *)
  n = ui.Boxes[id].Node
  p = pillItems(0, 0, shown(n.Text), n.Tone, dict.GetOr("Dot", true, n), ui.Theme, ui)
  cached(id, p.W, p.H, p.Items, {Text: shown(n.Text)}, ui)
end

defn layAsked(id, maxW, ui)
  (** The question of a view left with changes not saved, as a band in the color of warnings, its answers as
      buttons; nothing while none waits. *)
  r = ui.Router
  got = watched(id, () -> if value.IsMissing(r) missing else Get(r.Held) end, ui)
  u = got.Ui
  u.Asks = id
  if value.IsMissing(got.Value)
    return cached(id, maxW, 0, [], {Spots: [], Text: ""}, u)
  end
  t = u.Theme
  k = dict.Get("Tokens", t)
  say = u.Boxes[id].Node.Say
  q = said1(say, "Changes not saved. Leave without saving?")
  lh = lineOf(t.Size, u)
  pairs = [p for p in heldPairs(r)]
  label = {save: said1(say, "Save and leave"), leave: said1(say, "Discard changes"), stay: said1(say, "Keep editing")}
  styled = {save: "primary", leave: "danger", stay: "secondary"}
  bh = t.Field
  y0 = 10 + lh + 8
  x = 16
  items = []
  spots = []
  for p in list.Concat([["Esc", "", "stay"], ["C-d", "", "leave"]], [x1 for x1 in pairs if x1[3] == "save"])
    s = label[p[3]]
    bw = widthOf(s, t.Size, "body", u) + 20
    if x + bw > maxW - 12
      x = 16
      y0 += bh + 6
    end
    st = styled[p[3]]
    fill = if st == "primary" (if value.IsDict(k) k.Primary else t.Accent end) else if value.IsDict(k) k.Dropdown else t.Paper end
    ink = if st == "primary" 0xffffff else if st == "danger" (if value.IsDict(k) k.Err else t.Danger end) else role("Strong", t) if value.IsDict(k) else t.Ink end
    items = list.Append(rect(x, y0, bw, bh, fill, 4), items)
    items = list.Append(words(x + 10, y0 + math.Div(bh - lh, 2), s, t.Size, ink), items)
    spots = list.Append({X: x, Y: y0, W: bw, H: bh, Act: p[3], Text: s}, spots)
    x += bw + 8
  end
  h = y0 + bh + 10
  warn = if value.IsDict(k) k.Warn else role("Warn", t) end
  back = [{Kind: "rect", X: 0, Y: 0, W: maxW, H: h, Color: warn, Radius: 0, Alpha: 33}, words(16, 10, q, t.Size, warn, "strong")]
  cached(id, maxW, h, list.Concat(back, items), {Spots: spots, Text: q}, u)
end

defn layStrip(id, maxW, ui)
  (** The cells of a strip side by side, a line between two, on more lines when they don't fit. *)
  b = ui.Boxes[id]
  t = ui.Theme
  k = dict.Get("Tokens", t)
  u = ui
  ch = list.Max(28, t.Field + 4)
  x = 0
  y = 0
  lines = []
  for c in b.Kids
    u = layout(c, maxW - 24, true, u)
    cw = u.Boxes[c].W + 24
    if x > 0 and x + cw > maxW
      x = 0
      y += ch
    end
    u = place(c, x + 12, y + math.Div(ch - u.Boxes[c].H, 2), u)
    if c != b.Kids[value.Len(b.Kids)]
      lines = list.Append(rect(x + cw, y + 6, 1, ch - 12, if value.IsDict(k) k.Divider else t.Grid end), lines)
    end
    x += cw
  end
  h = y + ch
  own = list.Concat([rect(0, 0, maxW, h, if value.IsDict(k) k.Panel else role("Panel", t) end, 4), frame(0, 0, maxW, h, if value.IsDict(k) k.Divider else t.Grid end, 4)], lines)
  sized(id, maxW, h, list.Concat(own, kidGroups(u.Boxes[id], u)), u)
end

defn niceTop(x)
  (** The top of a scale for a largest value x: 1, 2, 2.5 or 5 times a power of ten, at least x. *)
  if x <= 0
    return 1
  end
  p = 1
  while p * 10 <= x
    p = p * 10
  end
  while p > x
    p = p / 10
  end
  for m in [1, 2, 2.5, 5, 10]
    if m * p >= x
      return m * p
    end
  end
  10 * p
end

defn seriesColor(tn, t)
  (** The color of a series: a slot of the charts, "S1" to "S5", or a role of a pill ("Warn", "Danger", "Ok"). *)
  k = dict.Get("Tokens", t)
  if value.IsDict(k) and value.IsSome(dict.Get(tn, k)) and value.IsNumber(k[tn])
    return k[tn]
  end
  toneColor(tn, t)
end

defn layMetric(id, maxW, ui)
  (** A graph of a dashboard on its card: its title and the time shown, its number with its unit and its note, the
      graph with the top of its scale, its lines (or its bars) and its crosshair, the times under it. *)
  b = ui.Boxes[id]
  n = b.Node
  got = watched(id, defn ()
    cross = if value.IsSome(n.Cross) Get(n.Cross) else missing end
    {Series: n.Series(), Cross: cross}
  end, ui)
  u = got.Ui
  t = u.Theme
  k = dict.Get("Tokens", t)
  z = sizesOf(t)
  series = got.Value.Series
  count = if value.IsEmpty(series) 0 else value.Len(series[1].Values) end
  cross = if value.IsNumber(got.Value.Cross) and got.Value.Cross >= 1 and got.Value.Cross <= count got.Value.Cross else missing end
  small = t.Size - 1.5
  sl = lineOf(small, u)
  lh = lineOf(t.Size, u)
  fs = z.Figure
  fl = lineOf(fs, u)
  px = 12
  card = if value.IsDict(k) k.Card else t.Paper end
  items = [rect(0, 0, maxW, 10, card, 4), frame(0, 0, maxW, 10, if value.IsDict(k) k.Divider else t.Grid end, 4)]
  y = 9
  title = shown(n.Title)
  pt = if value.IsSome(cross) and value.IsFunction(n.At) shown(n.At(cross)) else "now" end
  items = list.Append(words(px, y, title, small + 0.5, if value.IsDict(k) k.Icon else t.Ink end, "strong"), items)
  items = list.Append(words(maxW - px - widthOf(pt, small, "body", u), y, pt, small, t.Muted), items)
  y += sl + 2
  fig = shown(n.Figure(cross))
  fw = widthOf(fig, fs, "strong", u)
  items = list.Append(words(px, y, fig, fs, role("Strong", t) if value.IsDict(k) else t.Ink, "strong"), items)
  unit = shown(n.Unit)
  uw = widthOf(unit, small, "body", u)
  items = list.Append(words(px + fw + 6, y + fl - sl - 2, unit, small, t.Muted), items)
  note = shown(n.Note)
  if note != ""
    nx = list.Max(px + fw + 6 + uw + 12, maxW - px - widthOf(note, small, "body", u))
    items = list.Append(group(nx, y + fl - sl - 2, maxW - px - nx, sl, true, [words(0, 0, note, small, t.Muted)]), items)
  end
  y += fl + 4
  gh = if z.Row <= 24 52 else if z.Row <= 30 64 else 84 end
  gx = px
  gw = maxW - 2 * px
  highest = 0
  if n.Style == "bars"
    for i in 1..count
      highest = list.Max(highest, list.Sum([s.Values[i] for s in series]))
    end
  else
    for s in series
      for v in s.Values
        highest = list.Max(highest, v)
      end
    end
  end
  top = if value.IsSome(n.Most) n.Most else niceTop(highest) end
  grid = if value.IsDict(k) k.Grid else t.Grid end
  items = list.Append(rect(gx, y, gw, 1, grid), items)
  items = list.Append({Kind: "line", Points: [gx, y + math.Div(gh, 2), gx + gw, y + math.Div(gh, 2)], Color: grid, Width: 1, Dash: 3}, items)
  items = list.Append(rect(gx, y + gh, gw, 1, grid), items)
  xs = if count <= 1 [gx] else [gx + (i - 1) * gw / (count - 1) for i in 1..count] end
  yOf = v -> y + gh - gh * list.Min(1, v / top)
  if n.Style == "bars" and count > 0
    bw = list.Max(1, gw / count - 1)
    for i in 1..count
      base = 0
      for s in series
        v = s.Values[i]
        if v > 0
          c = seriesColor(s.Tone, t)
          y1 = yOf(base + v)
          y2 = yOf(base)
          items = list.Append(rect(gx + (i - 1) * gw / count, y1, bw, list.Max(1, y2 - y1), c), items)
        end
        base += v
      end
    end
  else if count > 1
    for j in 1..value.Len(series)
      s = series[j]
      c = seriesColor(s.Tone, t)
      pts = list.FlatMap(i -> [xs[i], yOf(s.Values[i])], 1..count)
      if j == 1 and n.Style == "area"
        tris = []
        for i in 1..(count - 1)
          a = [xs[i], yOf(s.Values[i])]
          b2 = [xs[i + 1], yOf(s.Values[i + 1])]
          tris = list.Concat(tris, [a[1], a[2], b2[1], b2[2], b2[1], y + gh, a[1], a[2], b2[1], y + gh, a[1], y + gh])
        end
        items = list.Append({Kind: "tris", Points: tris, Color: c, Alpha: 36}, items)
      end
      items = list.Append({Kind: "line", Points: pts, Color: c, Width: 1.5}, items)
    end
  end
  ytop = shown(top)
  items = list.Append(rect(gx, y - 1, widthOf(ytop, small - 1, "body", u) + 4, sl - 2, card), items)
  items = list.Append(words(gx, y - 2, ytop, small - 1, t.Muted), items)
  if value.IsSome(cross) and count > 0
    cx = if n.Style == "bars" gx + (cross - 0.5) * gw / count else xs[cross] end
    items = list.Append({Kind: "line", Points: [cx, y, cx, y + gh], Color: if value.IsDict(k) k.Icon else t.Muted end, Width: 1, Dash: 3}, items)
    if n.Style != "bars"
      for s in series
        cy = yOf(s.Values[cross])
        items = list.Append(rect(cx - 3, cy - 3, 6, 6, seriesColor(s.Tone, t), 3), items)
      end
    end
  end
  y += gh + 3
  ticks = if value.IsFunction(n.At) and count > 1 [shown(n.At(1)), shown(n.At(math.Div(count + 1, 2))), "now"] else ["", "", ""] end
  items = list.Append(words(gx, y, ticks[1], small - 1, t.Muted), items)
  items = list.Append(words(gx + math.Div(gw - widthOf(ticks[2], small - 1, "body", u), 2), y, ticks[2], small - 1, t.Muted), items)
  items = list.Append(words(gx + gw - widthOf(ticks[3], small - 1, "body", u), y, ticks[3], small - 1, t.Muted), items)
  h = y + sl + 6
  items[1] = rect(0, 0, maxW, h, card, 4)
  items[2] = frame(0, 0, maxW, h, if value.IsDict(k) k.Divider else t.Grid end, 4)
  cached(id, maxW, h, items, {Text: "$(shown(n.Label)): $fig $unit", Chart: [gx, y - gh - 3, gw, gh], Count: count, Bars: n.Style == "bars"}, u)
end

(* ---- The mouse, the keys and the palette over the page *)

defn shellOf(u)
  (** The box of the page's shell, or 0. *)
  id = dict.GetOr("Shell", 0, u)
  if id != 0 and id in u.Boxes and u.Boxes[id].Node.Kind == "shell" id else 0 end
end

defn sheetClose(u)
  (** The function that closes the sheet shown, or missing. *)
  s = shellOf(u)
  if s == 0
    return missing
  end
  sh = u.Boxes[s].Order[4]
  ks = u.Boxes[sh].Kids
  if value.IsEmpty(ks) or u.Boxes[ks[1]].Node.Kind != "sheet"
    return missing
  end
  dict.Get("Close", u.Boxes[ks[1]].Node)
end

defn shellModal(e, ui)
  (** What the shell does with an event before the widgets: the palette's keys and a click outside it, which closes
      it; a click outside the drawer, which closes it; Esc, which closes the palette, the drawer or the sheet; the keys
      that scroll the page while nothing has the focus. The page after, or missing when the event goes on as usual. *)
  s = shellOf(ui)
  if s == 0
    return missing
  end
  b = ui.Boxes[s]
  st = b.Node.State
  c = b.Cache
  find = nowOf(st.Find)
  key = if e.Kind == "key" chord(e) else missing end
  if find
    if key == "escape"
      Set(st.Find, false)
      return focus(0, ui)
    else if key == "down" or key == "up"
      n = value.Len(matching(st))
      Set(st.Pick, list.Max(1, list.Min(n, nowOf(st.Pick) + (1 if key == "down" else -1))))
      return ui
    else if key == "enter"
      _ = pickFind(st)
      return focus(0, ui)
    end
    if e.Kind == "mouse" and e.Action == "down"
      fd = b.Order[5]
      p = at(fd, ui)
      bx = ui.Boxes[fd]
      if e.X < p.X or e.X >= p.X + bx.W or e.Y < p.Y or e.Y >= p.Y + bx.H
        Set(st.Find, false)
        return focus(0, ui)
      end
    end
    return missing
  end
  if dict.GetOr("Drawer", false, c)
    if key == "escape"
      Set(st.Drawer, false)
      return ui
    end
    if e.Kind == "mouse" and e.Action == "down" and e.X >= c.DrawerW
      Set(st.Drawer, false)
      return ui
    end
  end
  if key == "escape"
    close = sheetClose(ui)
    if value.IsFunction(close)
      close()
      return focus(0, ui)
    end
  end
  if e.Kind == "key" and (ui.Focus == 0 or not (ui.Focus in ui.Boxes)) and key in ["down", "up", "pagedown", "pageup", "home", "end"]
    pg = b.Order[3]
    sc = ui.Boxes[pg]
    seen = dict.GetOr("Seen", sc.H, sc.Cache)
    by = if key == "down" 48 else if key == "up" (-48) else if key == "pagedown" seen - 48 else if key == "pageup" 48 - seen else if key == "home" (-1000000000) else 1000000000 end
    most = dict.GetOr("Most", 0, sc.Cache)
    Set(sc.Node.Offset, list.Max(0, list.Min(most, nowOf(sc.Node.Offset) + by)))
    return ui
  end
  missing
end

defn shellHover(h, ui)
  (** What the mouse is over in a widget of the web's layout, h in its box: {Id, Part, Cursor}, with Cross for a
      graph. *)
  b = ui.Boxes[h.Id]
  n = b.Node
  k = n.Kind
  if k == "nav"
    spot = list.FindFirst(s -> h.Y >= s.Y and h.Y < s.Y + s.H, b.Cache.Spots)
    j = if value.IsMissing(spot) missing else list.IndexOf(spot, b.Cache.Spots) end
    return {Id: if value.IsSome(j) h.Id else 0 end, Part: j, Cursor: "pointer" if value.IsSome(j) else "default"}
  else if k == "chips"
    i = list.FindFirst(j -> h.X >= b.Cache.Spans[j][1] and h.X < b.Cache.Spans[j][1] + b.Cache.Spans[j][2], 1..value.Len(b.Cache.Spans))
    return {Id: if value.IsSome(i) h.Id else 0 end, Part: i, Cursor: "pointer" if value.IsSome(i) else "default"}
  else if k == "picks"
    r = list.FindFirst(x -> h.Y >= x.Y and h.Y < x.Y + x.H, b.Cache.Rows)
    if value.IsSome(r)
      Set(n.State.Pick, r.I)
    end
    return {Id: 0, Part: missing, Cursor: "pointer" if value.IsSome(r) else "default"}
  else if k == "metric"
    ch = b.Cache.Chart
    if h.X >= ch[1] and h.X < ch[1] + ch[3] and b.Cache.Count > 0
      f = (h.X - ch[1]) / list.Max(1, ch[3])
      i = if b.Cache.Bars math.Div(math.Floor(f * b.Cache.Count), 1) + 1 else math.Div(math.Round(f * (b.Cache.Count - 1)), 1) + 1 end
      return {Id: 0, Part: missing, Cursor: "crosshair", Cross: n.Cross, At: list.Max(1, list.Min(b.Cache.Count, i))}
    end
    return {Id: 0, Part: missing, Cursor: "default", Cross: n.Cross, At: missing}
  else if k == "asked"
    s = list.FindFirst(x -> h.X >= x.X and h.X < x.X + x.W and h.Y >= x.Y and h.Y < x.Y + x.H, b.Cache.Spots)
    return {Id: 0, Part: missing, Cursor: "pointer" if value.IsSome(s) else "default"}
  else if k == "table"
    c = b.Cache
    head = dict.GetOr("Head", c.Row, c)
    if h.Y >= head and value.IsDict(c)
      i = math.Div(h.Y - head + c.Offset, c.Row) + 1
      return {Id: if i <= c.Count h.Id else 0 end, Part: if i <= c.Count i else missing end, Cursor: "pointer" if value.IsFunction(dict.Get("Open", n)) and i <= c.Count else "default"}
    end
    return {Id: 0, Part: missing, Cursor: "pointer" if h.Y < head else "default"}
  end
  {Id: 0, Part: missing, Cursor: "default"}
end

defn shellDown(h, e, ui)
  (** A press on a widget of the web's layout: a row of a nav goes to its route; a chip is chosen; a command of the
      palette runs; an answer of the question of changes not saved is given. *)
  u = ui
  b = u.Boxes[h.Id]
  n = b.Node
  k = n.Kind
  if k == "nav"
    u = focus(h.Id, u)
    spot = list.FindFirst(s -> h.Y >= s.Y and h.Y < s.Y + s.H, b.Cache.Spots)
    if value.IsSome(spot)
      Set(n.Cursor, list.IndexOf(spot, b.Cache.Spots))
      goNav(spot.Item, h.Id, u)
    end
    return u
  else if k == "chips"
    u = focus(h.Id, u)
    i = list.FindFirst(j -> h.X >= b.Cache.Spans[j][1] and h.X < b.Cache.Spans[j][1] + b.Cache.Spans[j][2], 1..value.Len(b.Cache.Spans))
    if value.IsSome(i)
      Set(n.Value, b.Cache.Spans[i][3])
    end
    return u
  else if k == "picks"
    r = list.FindFirst(x -> h.Y >= x.Y and h.Y < x.Y + x.H, b.Cache.Rows)
    if value.IsSome(r)
      Set(n.State.Pick, r.I)
      _ = pickFind(n.State)
      return focus(0, u)
    end
    return u
  else if k == "asked"
    s = list.FindFirst(x -> h.X >= x.X and h.X < x.X + x.W and h.Y >= x.Y and h.Y < x.Y + x.H, b.Cache.Spots)
    return if value.IsSome(s) heldAnswered(s.Act, u) else u end
  end
  u
end

defn goNav(one, id, u)
  (** Goes to the route of a row of a nav, and closes the drawer it is in. *)
  to = dict.Get("To", one)
  if value.IsSome(to) and value.IsSome(u.Router)
    _ = going(u.Router, to, missing)
  else if value.IsFunction(dict.Get("On", one))
    one.On()
  end
  s = above(id, "shell", u)
  if s != 0
    Set(u.Boxes[s].Node.State.Drawer, false)
  end
end

defn shellKey(e, ui)
  (** The keys of a nav or chips in focus: Up and Down along a nav's rows, Enter goes; Left and Right along chips. *)
  b = ui.Boxes[ui.Focus]
  n = b.Node
  if n.Kind == "nav"
    spots = b.Cache.Spots
    if value.IsEmpty(spots)
      return ui
    end
    now = nowOf(n.Cursor)
    i = if now == 0 (list.IndexOf(list.FindFirst(s -> s.On, spots), spots) if value.IsSome(list.FindFirst(s -> s.On, spots)) else 1) else now end
    if e.Key == "down" or e.Key == "up" or e.Key == "home" or e.Key == "end"
      j = if e.Key == "down" list.Min(value.Len(spots), i + 1) else if e.Key == "up" list.Max(1, i - 1) else if e.Key == "home" 1 else value.Len(spots) end
      Set(n.Cursor, j)
      return touch(ui.Focus, ui)
    else if e.Key == "enter" or e.Key == "space"
      goNav(spots[i].Item, ui.Focus, ui)
    end
    return ui
  end
  spans = b.Cache.Spans
  if value.IsEmpty(spans)
    return ui
  end
  i = list.FindFirst(j -> spans[j][3] == b.Cache.Now, 1..value.Len(spans))
  i0 = if value.IsMissing(i) 1 else i end
  j = if e.Key == "left" list.Max(1, i0 - 1) else if e.Key == "right" list.Min(value.Len(spans), i0 + 1) else if e.Key == "home" 1 else if e.Key == "end" value.Len(spans) else i0 end
  if j != i0
    Set(n.Value, spans[j][3])
  end
  ui
end

(* ---- The semantics tree and its patch *)

defn shellSem(b, x, y, ui, inner)
  (** The semantic nodes of the web layout's widgets: a nav of links, the chips as a group of radios, a pill and a
      graph as what they say, the question as an alert with its answers, the palette as a dialog, the shell as its
      parts (and its toast, a status). *)
  k = b.Node.Kind
  c = b.Cache
  if k == "nav"
    links = [{Id: "$(b.Id)n$j", Role: "link", Name: shown(c.Spots[j].Item.Label), Value: if value.IsMissing(c.Spots[j].Item.Count) missing else shown(c.Spots[j].Item.Count) end,
      X: x, Y: y + c.Spots[j].Y, W: b.W, H: c.Spots[j].H, Focused: false, Kids: [], Href: dict.Get("To", c.Spots[j].Item), Selected: c.Spots[j].On} for j in 1..value.Len(c.Spots)]
    return [node("navigation", b.Node.Label, b, x, y, ui, kids = links)]
  else if k == "chips"
    radios = [{Id: "$(b.Id)c$j", Role: "radio", Name: c.Spans[j][4], Value: missing, X: x + c.Spans[j][1], Y: y, W: c.Spans[j][2], H: b.H, Focused: false, Kids: [],
      Selected: c.Spans[j][3] == c.Now} for j in 1..value.Len(c.Spans)]
    return [node("radiogroup", b.Node.Label, b, x, y, ui, kids = radios)]
  else if k == "pill" or k == "metric"
    return [node(if k == "pill" "text" else "img" end, c.Text, b, x, y, ui)]
  else if k == "asked"
    if value.IsEmpty(c.Spots)
      return []
    end
    return [node("alert", c.Text, b, x, y, ui, kids = [{Id: "$(b.Id)a$j", Role: "button", Name: c.Spots[j].Text, Value: missing, X: x + c.Spots[j].X, Y: y + c.Spots[j].Y,
      W: c.Spots[j].W, H: c.Spots[j].H, Focused: false, Kids: []} for j in 1..value.Len(c.Spots)])]
  else if k == "picks"
    return [node("listbox", "", b, x, y, ui, kids = [{Id: "$(b.Id)p$(r.I)", Role: "option", Name: c.Found[r.I].Label, Value: missing, X: x, Y: y + r.Y, W: b.W, H: r.H,
      Focused: false, Kids: []} for r in c.Rows])]
  else if k == "pop"
    return [node("dialog", "", b, x, y, ui, kids = inner)]
  else if k == "shell"
    t = dict.Get("Toast", c)
    if value.IsSome(t)
      return list.Append({Id: "$(b.Id)toast", Role: "status", Name: t.Text, Value: missing, X: 0, Y: 0, W: 0, H: 0, Focused: false, Kids: []}, inner)
    end
    return inner
  end
  inner
end

defn shellPatch(id, at, since, ui)
  (** The patch of a widget of the web's layout, as patchDesk makes those of a desktop tool: its own nodes, and for a
      holder those of its children. *)
  b = ui.Boxes[id]
  x = at[3]
  y = at[4]
  ax = x - at[1]
  ay = y - at[2]
  ex = at[1] if b.W > 0 else x
  ey = at[2] if b.W > 0 else y
  f = ui.Focus == id
  k = b.Node.Kind
  c = b.Cache
  old = b.Sem
  had = value.IsSome(old)
  was = if had old.Node else missing end
  loose = b.W <= 0
  nax = x if b.W > 0 else ax
  nay = y if b.W > 0 else ay
  if k == "pill" or k == "metric"
    e = json.Text([id, if k == "pill" "text" else "img" end, c.Text, missing, ex, ey, b.W, b.H, f, missing])
    sent(e, was)
    return kept(id, at, loose, [id], e, ui)
  end
  if k == "shell" or k == "pop"
    (* a holder: the shell gives its children's nodes and its toast's, the palette a dialog of them *)
    u = ui
    sids = []
    for kid1 in b.Kids
      u = semWalk(kid1, if k == "pop" nax else ax end, if k == "pop" nay else ay end, x, y, since, u)
      sids = list.Concat(sids, u.Boxes[kid1].Sem.Sids)
      loose = loose or u.Boxes[kid1].Sem.Loose
    end
    if k == "pop"
      e = json.Text([id, "dialog", "", missing, ex, ey, b.W, b.H, f, missing])
      sent(e, was)
      ks = json.Text([id, sids])
      if not had or ks != old.Kids
        fiber.Send(ks, semKids)
      end
      return kept(id, at, loose, [id], e, u, kids = ks)
    end
    t = dict.Get("Toast", c)
    tid = "$(id)toast"
    te = if value.IsSome(t) json.Text([tid, "status", t.Text, missing, 0, 0, 0, 0, false, missing]) else missing end
    if value.IsSome(te)
      sent(te, if had old.Head else missing end)
    end
    return kept(id, at, loose, if value.IsSome(te) list.Append(tid, sids) else sids end, missing, u, head = te)
  end
  rows = dict.Dict()
  ids = []
  role1 = if k == "nav" "navigation" else if k == "chips" "radiogroup" else if k == "asked" "alert" else "listbox" end
  name = if k == "asked" or k == "picks" dict.GetOr("Text", "", c) else b.Node.Label end
  if k == "asked" and value.IsEmpty(c.Spots)
    return kept(id, at, false, [], missing, ui)
  end
  e = json.Text([id, role1, name, missing, ex, ey, b.W, b.H, f, missing])
  sent(e, was)
  before = if had and value.IsDict(old.Rows) old.Rows else dict.Dict() end
  parts = if k == "nav" [[c.Spots[j], j] for j in 1..value.Len(c.Spots)] else if k == "chips" [[c.Spans[j], j] for j in 1..value.Len(c.Spans)]
    else if k == "asked" [[c.Spots[j], j] for j in 1..value.Len(c.Spots)] else [[r, r.I] for r in c.Rows] end
  for pj in parts
    p = pj[1]
    j = pj[2]
    rid = "$(id)p$j"
    re = if k == "nav"
      json.Text([rid, "link", shown(p.Item.Label), if value.IsMissing(p.Item.Count) missing else shown(p.Item.Count) end, 0, p.Y, b.W, p.H, false, {Href: dict.Get("To", p.Item), Selected: p.On}])
    else if k == "chips"
      json.Text([rid, "radio", p[4], missing, p[1], 0, p[2], b.H, false, {Selected: p[3] == c.Now}])
    else if k == "asked"
      json.Text([rid, "button", p.Text, missing, p.X, p.Y, p.W, p.H, false, missing])
    else
      json.Text([rid, "option", c.Found[p.I].Label, missing, 0, p.Y, b.W, p.H, false, {Selected: p.I == nowOf(b.Node.State.Pick)}])
    end
    w = dict.Get(rid, before)
    sent(re, if value.IsSome(w) w else missing end)
    rows[rid] = re
    ids = list.Append(rid, ids)
  end
  ks = json.Text([id, ids])
  if not had or ks != old.Kids
    fiber.Send(ks, semKids)
  end
  kept(id, at, loose, [id], e, ui, kids = ks, rows = rows)
end
