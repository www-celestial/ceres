(* The themes of a desktop tool, dark and light, the setting that follows the system, the colors named by their role,
   and the icons. A color in a widget is a number 0xRRGGBB or the name of a role of the theme ("Panel", "Muted"), so a
   page looks right in both themes without a color of its own. *)
use std/bug
use std/dict
use std/math
use std/text
use std/value

(** The dark theme of a desktop tool, as an editor of games or of code draws one: grey panels on a darker window,
    fields and tables a step darker still, one blue for the choice and the focus, the text light grey; sizes on a grid
    of 4 pixels, dense rows. Each pair of a text and its background reaches the contrast of WCAG 2.2 AA (4.5:1), and
    the edge of a field and the ring of the focus 3:1 (web.Contrast measures them; tests/dock.test.ce checks it).
    Its fields are those of web.Theme and these: Panel, the body of a panel; Header, the strip of its tabs, a toolbar
    and the status bar; Raised, a button; Hover and Pressed, a widget under the mouse and held down; Disabled; Edge,
    the edge of a table or a panel; Link; Warn and Ok, the colors of a warning and of a success; Rule, the grid of a
    graph; Unit, the step of the grid of sizes; Icon, the size of an icon; Tab, the height of a strip of tabs; Bar,
    that of a toolbar.

      Dark.Name --> "dark" *)
Dark = {Name: "dark", Size: 13, Title: 16, Unit: 4, Icon: 16, Tab: 28, Bar: 34,
  Back: 0x151515, Panel: 0x242424, Header: 0x1c1c1c, Paper: 0x161616, Raised: 0x333333, Hover: 0x383838, Pressed: 0x111111,
  Ink: 0xdcdcdc, Muted: 0xa8a8a8, Disabled: 0x6e6e6e, Line: 0x737373, Edge: 0x383838, Grid: 0x2e2e2e, Rule: 0x333333,
  Accent: 0x3b82f0, Chosen: 0x1f5fb0, ChosenInk: 0xffffff, Link: 0x6cb4ff, Danger: 0xff7b7b, Warn: 0xe8a838, Ok: 0x5fcf75,
  Band: 0x1c1c1c, Gap: 8, Pad: 4, Radius: 2, Field: 24, Row: 22, Page: 12, Keys: true}

(** The light theme of the same tool: the same roles and sizes, grey panels around white fields and tables.

      Light.Paper --> 0xffffff *)
Light = {Name: "light", Size: 13, Title: 16, Unit: 4, Icon: 16, Tab: 28, Bar: 34,
  Back: 0xd4d4d4, Panel: 0xf3f3f3, Header: 0xe4e4e4, Paper: 0xffffff, Raised: 0xfbfbfb, Hover: 0xd8d8d8, Pressed: 0xc4c4c4,
  Ink: 0x1c1c1c, Muted: 0x595959, Disabled: 0x9a9a9a, Line: 0x7a7a7a, Edge: 0xc8c8c8, Grid: 0xe2e2e2, Rule: 0xe0e0e0,
  Accent: 0x0a64d2, Chosen: 0x1a62c4, ChosenInk: 0xffffff, Link: 0x0055b3, Danger: 0xb82518, Warn: 0x7d5000, Ok: 0x1a6e2e,
  Band: 0xe4e4e4, Gap: 8, Pad: 4, Radius: 2, Field: 24, Row: 22, Page: 12, Keys: true}

(** The theme that follows the system: dark while the system says dark (the browser's prefers-color-scheme, SDL's
    theme of the system), light while it says light, dark when it says nothing; it changes with it. web.App takes it
    as its theme, as it takes Dark or Light.

      System().Kind --> "system" *)
System(dark = Dark, light = Light) = {Kind: "system", Dark: dark, Light: light}

isSystem(t) = value.IsDict(t) and dict.Get("Kind", t) == "system"   (* Is this the theme that follows the system? *)

defn themeFor(theme, dark)
  (** The theme to draw with: theme itself, or for web.System its dark or its light one; dark is missing when the
      back-end can't tell. *)
  if not isSystem(theme)
    return theme
  end
  if dark == false theme.Light else theme.Dark end
end

(* The roles that web.Theme, the plain theme of before, lacks: each the role it takes the color of, or its value. *)
older = {Panel: "Paper", Header: "Band", Raised: "Paper", Hover: "Band", Pressed: "Grid", Edge: "Line", Link: "Accent",
  Disabled: "Muted", Warn: 0x8a5a00, Ok: 0x1e6b2e, Rule: 0xe6eaef, Unit: 4, Icon: 16, Tab: 26, Bar: 32}

defn role(name, t)
  (** A field of the theme t, as "Panel": its own, or for a theme made before the field was, the one it stands for. *)
  got = dict.Get(name, t)
  if value.IsSome(got)
    return got
  end
  instead = dict.Get(name, older)
  if value.IsText(instead) dict.Get(instead, t) else instead end
end

defn tone(c, t)
  (** A color as a number: c itself, or the color of the theme t that a name gives, "Panel" for t.Panel; missing
      stays missing. Ceres's own widgets give a pair [role, color]: the role in a theme of a desktop tool (one that has
      Raised), the color in web.Theme, whose look stays as it was. *)
  if value.IsArray(c)
    return if value.IsSome(dict.Get("Raised", t)) tone(c[1], t) else c[2] end
  end
  if value.IsText(c)
    got = role(c, t)
    if not value.IsNumber(got)
      bug.Panic("The theme has no color named $c: a color is 0xRRGGBB or a role of the theme, as \"Muted\" or \"Panel\".")
    end
    return got
  end
  c
end

defn channel(v)
  (** One channel of sRGB, 0 to 255, as light: WCAG 2.2's relative luminance of it. *)
  s = v / 255.0
  if s <= 0.04045 s / 12.92 else math.Exp(2.4 * math.Log((s + 0.055) / 1.055)) end
end

luminance(c) = 0.2126 * channel(math.Div(c, 65536)) + 0.7152 * channel(math.Mod(math.Div(c, 256), 256)) + 0.0722 * channel(math.Mod(c, 256))

defn Contrast(a, b)
  (** The contrast of two colors 0xRRGGBB as WCAG 2.2 measures it, from 1 to 21: a text needs 4.5 against its
      background for AA, a large text, the edge of a field or a ring of focus 3.

        Contrast(0x000000, 0xffffff) --> 21.0 *)
  la = luminance(a)
  lb = luminance(b)
  hi = la if la > lb else lb
  lo = lb if la > lb else la
  math.Round((hi + 0.05) / (lo + 0.05) * 100) / 100
end

(* ---- Icons: Lucide (https://lucide.dev, ISC), icons drawn with strokes on a grid of 24, as the font
   src/sdl/fonts/Lucide.ttf and web/icons.js hold them, the 158 of this table only (tools/icons.sh). *)

(* The icons as texts of name:code, the code point in hex, a space between: a table of records would make every page
   carry ten times its bytes in its module. tools/icons.sh reads the code points from here. *)
iconCodes = [
  "activity:e038 archive:e041 arrow-down:e042 arrow-left:e048 arrow-left-right:e24a arrow-right:e049 arrow-up:e04a",
  "arrow-up-down:e37d badge-check:e241 ban:e051 bell:e059 bell-dot:e42b book:e05e bookmark:e060 box:e061 bug:e20c",
  "building:e1cc calendar:e063 chart-column:e2a3 chart-line:e2a5 chart-pie:e06b check:e06c check-check:e38e",
  "chevron-down:e06d chevron-left:e06e chevron-right:e06f chevron-up:e070 chevrons-down-up:e228",
  "chevrons-up-down:e211 circle:e076 circle-check:e226 circle-dot:e345 circle-exclamation-point:e077",
  "circle-question-mark:e082 circle-stop:e083 circle-user:e461 circle-x:e084 clock:e087 cloud:e088",
  "cloud-download:e089 cloud-upload:e091 code:e093 cog:e30b columns-2:e098 copy:e09e credit-card:e0aa database:e0ad",
  "download:e0b2 ellipsis:e0b6 ellipsis-vertical:e0b7 external-link:e0b9 eye:e0ba eye-off:e0bb fast-forward:e0bd",
  "file-code:e0c3 file-plus:e0c9 file-search:e0cb file-text:e0cc files:e0cf flag:e0d1 flask-conical:e0d5",
  "folder:e0d7 folder-open:e247 folder-plus:e0d9 funnel:e0dc gift:e0e1 globe:e0e8 grip-horizontal:e0ea",
  "grip-vertical:e0eb hash:e0ef house:e0f5 inbox:e0f7 info:e0f9 key:e0fd layers:e529 layout-dashboard:e1c1",
  "layout-grid:e0ff lightbulb:e1c2 link:e102 list:e106 list-checks:e1d0 list-filter:e460 list-tree:e408 list-x:e240",
  "lock:e10b lock-open:e10c log-in:e10d log-out:e10e logs:e5f4 mail:e10f map-pin:e111 maximize:e112 menu:e115",
  "message-square:e117 milestone:e298 minimize:e11a minus:e11c monitor:e11d moon:e11e package:e129",
  "panel-bottom:e42c panel-left:e12a panel-right:e431 pause:e12e pencil:e1f9 pin:e259 play:e13c plug:e37f plus:e13d",
  "radio:e142 radio-tower:e404 receipt:e3d3 redo-2:e2a0 refresh-ccw:e144 refresh-cw:e145 rocket:e286",
  "rotate-ccw:e148 rotate-ccw-clock:e1f5 rows-2:e439 rss:e14a save:e14d save-all:e40f scale:e212 search:e151",
  "send:e152 server:e153 server-cog:e341 settings:e154 share:e155 shield:e158 sliders-horizontal:e29a square:e167",
  "square-terminal:e20a star:e176 sticky-note:e303 sun:e178 sun-moon:e2b2 table:e17d tag:e17f target:e180",
  "terminal:e181 text-cursor-input:e265 timer:e1e0 toggle-left:e18b trash:e18d triangle-exclamation-point:e193",
  "type:e198 undo-2:e2a1 upload:e19e user:e19f user-plus:e1a2 users:e1a4 variable:e473 webhook:e374 wrench:e1b1",
  "x:e1b2 zoom-in:e1b6 zoom-out:e1b7"
]

defn iconTable(lines)
  (** The table of the icons, from their texts. *)
  out = dict.Dict()
  for line in lines
    for one in text.Split(" ", line)
      p = text.Split(":", one)
      cp = 0
      for b in text.Bytes(p[2])
        cp = cp * 16 + (b - 48 if b < 58 else b - 87)
      end
      out[p[1]] = cp
    end
  end
  out
end

(** The icons a widget names, by their names in Lucide (as lucide.dev shows them), each its code point in the font of
    the icons.

      Icons["settings"] --> 0xe154 *)
Icons = iconTable(iconCodes)

defn glyph(name)
  (** The text of an icon: its character in the font of the icons, from its name, or a code point of that font. *)
  cp = if value.IsNumber(name) name else dict.Get(name, Icons) end
  if value.IsMissing(cp)
    bug.Panic("There is no icon named $name in web.Icons: its names are those of Lucide, as \"database\" or \"settings\".")
  end
  text.FromBytes([224 + math.Div(cp, 4096), 128 + math.Mod(math.Div(cp, 64), 64), 128 + math.Mod(cp, 64)])
end

defn Icon(name, size = missing, color = missing)
  (** An icon of web.Icons, as "database", in a square of size pixels (the theme's Icon by default), in a color, the
      text's by default: a number 0xRRGGBB or a role of the theme. A screen reader doesn't read it: what it says is in
      the label beside it.

        Icon("settings").Kind --> "icon" *)
  {Kind: "icon", Name: name, Glyph: glyph(name), Size: size, Color: color, Kit: kit}
end
