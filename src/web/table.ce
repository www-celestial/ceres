(* Big tables: only the rows in sight are drawn, so a million rows cost as thirty. The rows come from a signal of a list,
   sorted here, or from the app, a window of rows at a time (web.Pages). *)
use std/dict
use std/fiber
use std/list
use std/math
use std/text
use std/value

defn Table(source, columns, height = 400, rowHeight = missing, width = missing, label = "", checks = missing, key = missing, open = missing, picked = missing)
  (** A table of rows under a header, with a scroll bar: source is a signal of a list of rows, a list, or web.Pages,
      the rows the app gives a window at a time; columns are web.Column. Only the rows in sight are drawn. A click on
      the title of a column that sorts sorts by it, a second click the other way. The wheel scrolls it, and so do Up,
      Down, Page Up, Page Down, Home and End while it has the focus; a click chooses a row. label names it for a screen
      reader. height missing makes it as tall as its rows, for a page that scrolls by itself (web.Shell).

      key(row) tells its rows apart, for these: checks, a signal of a dictionary of the keys checked, puts a box to
      check before each row and one in the header for all the rows shown (web.Bulk acts on them); open(row) runs when a
      row is chosen, as a click on it or Enter does, to show it (its address, web.Go); picked, a signal of the key of
      the row shown, marks that row chosen while it holds it, as the address of a row opened does. In web.Dark and
      web.Light, a row is striped, lit under the mouse, and in a web.Shell on a phone (a window under 760 pixels) drawn
      as a card of two lines: its first columns as its title, the others under it, its amount and its pill at its right.

        Table([{N: 1}], [Column("N", r -> r.N)]).Kind --> "table" *)
  {Kind: "table", Source: source, Columns: columns, Height: height, RowHeight: rowHeight, Width: width, Label: label,
    Offset: Signal(0), Sort: Signal(missing), Chosen: Signal(missing), Checks: checks, KeyOf: key, Open: open, Picked: picked}
end

defn Pill(words, tone = "Muted", dot = true)
  (** A short word of a state in a pill of its color, as Paid, Unpaid or Overdue: tone a role of the theme, "Ok",
      "Warn", "Danger", "Info", "Link" or "Muted"; the pill holds a dot before the word unless dot = false. A state
      always says its word, never a color alone. A cell of a web.Table may give one.

        Pill("Paid", tone = "Ok").Kind --> "pill" *)
  {Kind: "pill", Text: words, Tone: tone, Dot: dot, Role: "text", Kit: kit}
end

isPill(x) = value.IsDict(x) and dict.Get("Kind", x) == "pill"   (* Is this a pill? *)

defn toneColor(name, t)
  (** The color of a tone of a pill, in a theme. *)
  k = dict.Get("Tokens", t)
  if value.IsDict(k)
    m = {Ok: k.Ok, Warn: k.Warn, Danger: k.Err, Err: k.Err, Info: k.Info, Link: role("Link", t), Accent: role("Link", t), Violet: k.Violet, Muted: k.Icon}
    if name in m
      return m[name]
    end
  end
  tone(name, t)
end

defn pillItems(x, y, words, tn, dot, t, u, on = false)
  (** The items of a pill at x, y: {Items, W, H}; on, in a chosen row, white on white at 18 %. *)
  size = t.Size - 1.5
  h = 18 if t.Row <= 24 else 20 if t.Row <= 30 else 22
  c = if on 0xffffff else toneColor(tn, t) end
  tw = widthOf(words, size, "body", u)
  w = tw + (26 if dot else 14)
  muted = tn == "Muted" and not on
  (* the tint of its color at 14 % over the wells' grey, solid, whatever is under it: its text keeps the contrast the
     look measures (tokens.md); in the row chosen, white on a darker blue *)
  fill = if on {Kind: "rect", X: x, Y: y, W: w, H: h, Color: 0x000000, Radius: math.Div(h, 2), Alpha: 64}
    else if muted rect(x, y, w, h, tok("Dropdown", t, "Header"), math.Div(h, 2))
    else rect(x, y, w, h, tinted(c, tok("Recessed", t, "Paper"), 14), math.Div(h, 2)) end
  out = [fill]
  tx = x + 7
  if dot
    out = list.Append(rect(x + 7, y + math.Div(h - 6, 2), 6, 6, c, 3), out)
    tx = x + 19
  end
  {Items: list.Append(words1(tx, y + math.Div(h - lineOf(size, u), 2), words, size, c), out), W: w, H: h}
end

defn tinted(c, under, percent)
  (** A color c at percent % over the color under, as one color. *)
  out = 0
  for shift in [65536, 256, 1]
    a = math.Mod(math.Div(c, shift), 256)
    b = math.Mod(math.Div(under, shift), 256)
    out += math.Div(math.Round(a * percent + b * (100 - percent)), 100) * shift
  end
  out
end

words1(x, y, s, size, color) = {Kind: "text", X: x, Y: y, Text: s, Size: size, Color: color, Font: "body"}   (* A text item. *)

defn Column(title, cell, sort = missing, align = missing, width = missing)
  (** A column of a web.Table: its title, and cell(row), what it shows of a row: a value, or a text widget as
      web.Money gives. sort is the field the rows are sorted by when its title is clicked, missing for a column that
      doesn't sort; align is "left" or "right", and by default numbers and amounts go right, in the code font, and
      the rest left; width in pixels, else the columns share the width left.

        Column("Total", r -> r.Total, align = "right").Align --> "right" *)
  {Title: title, Cell: cell, Sort: sort, Align: align, Width: width}
end

defn Pages(name, p, chunk = 100)
  (** The rows of a table that the app gives a window at a time: the action name of the app's screen, called with
      {Sort, Desc, Offset, Limit}, gives {Rows, Count}, the rows from Offset + 1, at most Limit of them, in the order of
      the field Sort, and how many there are in all. The table asks for chunk rows at a time, those in sight, once each
      until the order changes. src/serve makes such an action: serve.Pages. *)
  {Kind: "pages", Name: name, Screen: p.Screen, Chunk: chunk, Loaded: Signal(0),
    Store: cell({Sort: missing, Desc: false, Count: missing, Chunks: dict.Dict(), Asked: dict.Dict(), Era: 0})}
end

isPages(s) = value.IsDict(s) and dict.Get("Kind", s) == "pages"   (* Is this a source of web.Pages? *)

defn sortedRows(id, n, order, u)
  (** The rows of a local table in the order asked, sorted once for each version of the rows and each order. *)
  rows = if isSignal(n.Source) Get(n.Source) else n.Source end
  ver = if isSignal(n.Source) version(n.Source) else 0 end
  c = u.Boxes[id].Cache
  kept = if value.IsDict(c) dict.Get("Sorted", c) else missing end
  if value.IsSome(kept) and kept.Ver == ver and value.Equal(kept.Order, order)
    return {Rows: kept.Rows, Count: value.Len(kept.Rows), Ver: ver}
  end
  done = if value.IsMissing(order) rows else list.SortBy(r -> r[order.By], rows) end
  {Rows: list.Reverse(done) if value.IsSome(order) and order.Desc else done, Count: value.Len(done), Ver: ver}
end

defn pageRows(src, order, first, count)
  (** The rows first to first + count - 1 of a web.Pages source, missing for those not here yet, which it asks for:
      {Rows, Count}, Count missing until the app answered once. *)
  _ = Get(src.Loaded)
  up = Get(src.Screen.Up)
  st = peek(src.Store)
  by = if value.IsMissing(order) missing else order.By end
  desc = if value.IsMissing(order) false else order.Desc end
  if st.Sort != by or st.Desc != desc
    st = {Sort: by, Desc: desc, Count: st.Count, Chunks: dict.Dict(), Asked: dict.Dict(), Era: st.Era + 1}
  end
  k0 = math.Div(first - 1, src.Chunk)
  k1 = math.Div(list.Max(first, first + count - 2), src.Chunk)
  for k in k0..k1
    if up and not (k in st.Chunks) and not (k in st.Asked) and (value.IsMissing(st.Count) or k * src.Chunk < st.Count)
      st.Asked[k] = true
      ask(src, st.Era, by, desc, k)
    end
  end
  put(st, src.Store)
  out = []
  for r in first..(first + count - 1)
    k = math.Div(r - 1, src.Chunk)
    rows = dict.Get(k, st.Chunks)
    i = r - k * src.Chunk
    out = list.Append(if value.IsSome(rows) and i <= value.Len(rows) rows[i] else missing end, out)
  end
  {Rows: out, Count: st.Count}
end

defn ask(src, era, by, desc, k)
  (** Asks the app for the chunk k of a web.Pages source; its reply is kept if the order didn't change since. *)
  actThen(src.Name, {Sort: by, Desc: desc, Offset: k * src.Chunk, Limit: src.Chunk}, src.Screen, defn (got)
    st = peek(src.Store)
    if st.Era == era and value.IsDict(got) and "Ok" in got and value.IsDict(got.Ok)
      st.Chunks[k] = got.Ok.Rows
      st.Count = got.Ok.Count
      put(st, src.Store)
      Set(src.Loaded, Get(src.Loaded) + 1)
    else if st.Era == era
      st.Asked = dict.Drop(k, st.Asked)
      put(st, src.Store)
    end
  end)
end

(* ---- The memory of the views: a table mounted again in a route seen before (Back, a link to it, the page made
   again by a live part) comes back with its order, its scroll and its row chosen as they were. *)

defn tableMemory(n, ui)
  (** What a table is known by in the memory of the views: the view shown (the route, or in a web.Shell its view,
      so that a row opened in its sheet keeps the list as it was), its label and the titles of its columns. Two
      tables alike in one view share it. *)
  "$(viewKey(ui)) table $(n.Label) $(text.Join("|", [if value.IsText(c.Title) c.Title else "" end for c in n.Columns]))"
end

defn viewKey(ui)
  (** The view shown: the shell's (its view), or the route. *)
  s = dict.GetOr("Shell", 0, ui)
  if s != 0 and s in ui.Boxes and value.IsFunction(dict.Get("View", ui.Boxes[s].Node)) ui.Boxes[s].Node.View() else nowOf(ui.Nav) end
end

defn recalled(n, ui)
  (** A table as it was the last time its route showed it, if it did. *)
  if value.IsMissing(ui.Router)
    return missing
  end
  kept = dict.Get(tableMemory(n, ui), peek(ui.Router.Views))
  if value.IsSome(kept)
    quiet(n.Sort, kept.Sort)
    quiet(n.Offset, kept.Offset)
    quiet(n.Chosen, kept.Chosen)
  end
  missing
end

defn colWidths(cols, w)
  (** The width of each column: its own, or a share of what is left. *)
  fixed = list.Sum([c.Width for c in cols if value.IsSome(c.Width)])
  free = value.Len([c for c in cols if value.IsMissing(c.Width)])
  share = if free > 0 math.Div(list.Max(0, w - fixed), free) else 0 end
  [share if value.IsMissing(c.Width) else c.Width for c in cols]
end

scrollBar = 8   (* The width of a table's scroll bar, in pixels. *)

defn tableGeometry(n, u, h)
  (** The row height and the height of a table's body, the table h pixels high. *)
  rh = u.Theme.Row if value.IsMissing(n.RowHeight) else n.RowHeight
  {Row: rh, Body: h - rh}
end

defn layTable(id, maxW, ui)
  (** A table as high as its height, or, when web.Grow marks it in a place that has a height (a panel's), as that
      place leaves it, or with no height as tall as its rows. *)
  b = ui.Boxes[id]
  n = b.Node
  w = list.Min(maxW, 10000 if value.IsMissing(n.Width) else n.Width)
  h = if value.IsSome(b.Gh) and dict.GetOr("Grow", 0, n) > 0 list.Max(2 * (ui.Theme.Row), b.Gh) else n.Height end
  tokens = value.IsSome(dict.Get("Tokens", ui.Theme))
  got = watched(id, () -> (if tokens tokenView(id, n, w, ui, h) else tableView(id, n, w, ui, h) end), ui)
  u = got.Ui
  if value.IsSome(u.Router)
    put(dict.Put(tableMemory(n, u), {Sort: nowOf(n.Sort), Offset: nowOf(n.Offset), Chosen: nowOf(n.Chosen)}, peek(u.Router.Views)), u.Router.Views)
  end
  cached(id, w, dict.GetOr("H", h, got.Value), got.Value.Items, got.Value.Cache, u)
end

defn tableView(id, n, w, u, height)
  (** The items of a table at its scroll, and what its box keeps: {Items, Cache}. A table has real edges: a line under
      its header, between its rows and between its columns. Numbers and amounts sit at the right of their column, in
      the code font; the chosen row is ink on paper turned round. The items of each row in sight are kept, in Lines,
      at the row's place in the whole table, and a group moves them by the scroll: a row that stays in sight with the
      same values, the same widths and the same choice is not made again. *)
  t = u.Theme
  g = tableGeometry(n, u, height)
  rh = g.Row
  order = Get(n.Sort)
  data = if isPages(n.Source) missing else sortedRows(id, n, order, u) end
  count0 = if value.IsMissing(data) dict.Get("Count", peek(n.Source.Store)) else data.Count end
  count = 0 if value.IsMissing(count0) else count0
  most = list.Max(0, count * rh - g.Body)
  offset = list.Max(0, list.Min(Get(n.Offset), most))
  first = math.Div(offset, rh) + 1
  seen = list.Min(math.Div(g.Body, rh) + 2, list.Max(0, count - first + 1))
  slice = if seen <= 0 [] else if value.IsMissing(data) pageRows(n.Source, order, first, seen).Rows else data.Rows[first..(first + seen - 1)] end
  if value.IsMissing(count0) and isPages(n.Source)
    _ = pageRows(n.Source, order, 1, 1)
  end
  chosen = Get(n.Chosen)
  inner = w - scrollBar
  cw = colWidths(n.Columns, inner)
  lh = lineOf(t.Size, u)
  ty = math.Div(rh - lh, 2)
  sample = list.FindFirst(r -> value.IsSome(r), slice)
  rights = [col.Align == "right" or (value.IsMissing(col.Align) and value.IsSome(sample) and fontOf(col.Cell(sample)) == "code") for col in n.Columns]
  old = u.Boxes[id].Cache
  kept = if value.IsDict(old) and "Lines" in old and value.Equal(old.Widths, cw) and value.Equal(old.Rights, rights) and value.Equal(dict.Get("Look", old), t) old.Lines else dict.Dict() end
  lines = dict.Dict()
  for k in 1..value.Len(slice)
    i = first + k - 1
    row = slice[k]
    e = dict.Get(i, kept)
    if value.IsSome(e) and e.Pure and e.On == (i == chosen) and value.Equal(e.Row, row)
      lines[i] = e
    else
      made = track(() -> line(i, row, i == chosen, n.Columns, cw, rights, inner, rh, ty, t, u))
      for r in made.Reads
        fiber.Send(r, reads)
      end
      one = made.Value
      one.Pure = value.IsEmpty(made.Reads)
      lines[i] = one
    end
  end
  top = (first + value.Len(slice)) * rh
  items = [rect(0, 0, w, height, t.Paper)]
  band = dict.Get("Header", t)
  if value.IsSome(band)
    items = list.Append(rect(0, 0, w, rh, band), items)
  end
  rows = [group(0, -offset, inner, top, false, list.FlatMap(k -> lines[first + k - 1].Back, 1..value.Len(slice)))]
  texts = [lines[first + k - 1].Texts for k in 1..value.Len(slice)]
  x = 0
  for c in 1..value.Len(n.Columns)
    col = n.Columns[c]
    mark = if value.IsSome(order) and value.IsSome(col.Sort) and order.By == col.Sort (" v" if order.Desc else " ^") else "" end
    head = "$(col.Title)$mark"
    hx = if rights[c] cw[c] - 6 - widthOf(head, t.Size, "strong", u) else 6 end
    items = list.Append(group(x, 0, cw[c], rh, true, [words(hx, ty, head, t.Size, t.Ink, "strong")]), items)
    cells = [lines[first + k - 1].Cells[c] for k in 1..value.Len(slice)]
    rows = list.Append(group(x, 0, cw[c], g.Body, true, [group(0, -offset, cw[c], top, false, cells)]), rows)
    if c > 1
      items = list.Append(rect(x, 0, 1, height, t.Grid), items)
    end
    x += cw[c]
  end
  items = list.Append(group(0, rh, inner, g.Body, true, rows), items)
  items = list.Append(rect(0, rh - 1, w, 1, role("Edge", t) if value.IsSome(band) else t.Line), items)
  items = list.Append(rect(inner, 0, 1, height, t.Grid), items)
  if most > 0
    thumb = list.Max(20, math.Div(g.Body * g.Body, count * rh))
    y0 = rh + math.Div((g.Body - thumb) * offset, most)
    items = list.Append(rect(inner + 2, y0, scrollBar - 4, thumb, t.Muted), items)
  end
  items = list.Append(frame(0, 0, w, height, t.Accent if u.Focus == id else role("Edge", t)), items)
  keep = if value.IsMissing(data) missing else {Ver: data.Ver, Order: order, Rows: data.Rows} end
  {Items: items, Cache: {Sorted: keep, First: first, Seen: seen, Count: count, Most: most, Offset: offset, Widths: cw, Row: rh,
    Texts: texts, Lines: lines, Rights: rights, Look: t}}
end

defn tokenView(id, n, w, u, height)
  (** The items of a table in a theme of tokens (web.Dark, web.Light), and what its box keeps, as tableView: a header
      on the band of column titles, rows striped, lit under the mouse, the chosen one in the color of the choice with
      its texts white; no lines between rows or columns, the table on its card with a quiet edge; a box to check
      before each row with checks; on a phone, each row a card of two lines. height missing: as tall as its rows. *)
  t = u.Theme
  k = t.Tokens
  phone = u.Width < 760 and shelled(u)
  lh = lineOf(t.Size, u)
  rh = if value.IsSome(n.RowHeight) n.RowHeight else if phone 2 * lh + 16 else t.Row end
  head = if phone 0 else rh end
  order = Get(n.Sort)
  data = if isPages(n.Source) missing else sortedRows(id, n, order, u) end
  count0 = if value.IsMissing(data) dict.Get("Count", peek(n.Source.Store)) else data.Count end
  count = 0 if value.IsMissing(count0) else count0
  h = if value.IsMissing(height) list.Min(50000, head + list.Max(1, count) * rh + 2) else height end
  body = h - head
  most = list.Max(0, count * rh - body)
  offset = list.Max(0, list.Min(Get(n.Offset), most))
  first = math.Div(offset, rh) + 1
  seen = list.Min(math.Div(body, rh) + 2, list.Max(0, count - first + 1))
  slice = if seen <= 0 [] else if value.IsMissing(data) pageRows(n.Source, order, first, seen).Rows else data.Rows[first..(first + seen - 1)] end
  if value.IsMissing(count0) and isPages(n.Source)
    _ = pageRows(n.Source, order, 1, 1)
  end
  picked = if value.IsSome(dict.Get("Picked", n)) and value.IsFunction(dict.Get("KeyOf", n)) Get(n.Picked) else missing end
  chosen = if value.IsSome(picked) missing else Get(n.Chosen) end
  checks = if value.IsSome(dict.Get("Checks", n)) and value.IsFunction(dict.Get("KeyOf", n)) Get(n.Checks) else missing end
  box = if value.IsSome(checks) and not phone 36 else 0 end
  inner = w - 2
  cw = colWidths(n.Columns, inner - box)
  ty = math.Div(rh - lh, 2)
  sample = list.FindFirst(r -> value.IsSome(r), slice)
  rights = [col.Align == "right" or (value.IsMissing(col.Align) and value.IsSome(sample) and fontOf(col.Cell(sample)) == "code") for col in n.Columns]
  hot = if u.Hover == id dict.Get("HoverPart", u) else missing end
  old = u.Boxes[id].Cache
  kept = if value.IsDict(old) and "Lines" in old and value.Equal(old.Widths, cw) and value.Equal(old.Rights, rights) and value.Equal(dict.Get("Look", old), t) and dict.Get("Phone", old) == phone old.Lines else dict.Dict() end
  lines = dict.Dict()
  for j in 1..value.Len(slice)
    i = first + j - 1
    row = slice[j]
    on = if value.IsSome(picked) value.IsSome(row) and n.KeyOf(row) == picked else i == chosen end
    lit = hot == i
    ticked = value.IsSome(checks) and value.IsSome(row) and n.KeyOf(row) in checks
    e = dict.Get(i, kept)
    if value.IsSome(e) and e.Pure and e.On == on and e.Lit == lit and e.Ticked == ticked and value.Equal(e.Row, row)
      lines[i] = e
    else
      made = track(() -> tokenLine(i, row, on, lit, ticked, box, n.Columns, cw, rights, inner, rh, ty, t, u, phone))
      for r in made.Reads
        fiber.Send(r, reads)
      end
      one = made.Value
      one.Pure = value.IsEmpty(made.Reads)
      lines[i] = one
    end
  end
  top = (first + value.Len(slice)) * rh
  items = [rect(0, 0, w, h, k.Card, 4)]
  if head > 0
    items = list.Append(rect(1, 1, w - 2, head - 1, k.Header, 3), items)
  end
  rows = [group(0, -offset, inner, top, false, list.FlatMap(j -> lines[first + j - 1].Back, 1..value.Len(slice)))]
  texts = [lines[first + j - 1].Texts for j in 1..value.Len(slice)]
  small = t.Size - 1.5
  if box > 0 and head > 0
    all = list.All([value.IsSome(r) and n.KeyOf(r) in checks for r in slice]) and value.Len(slice) > 0
    items = list.Concat(items, checkItems(12, math.Div(head - 14, 2), all, t))
  end
  x = box
  for c in 1..value.Len(n.Columns)
    col = n.Columns[c]
    sorted = value.IsSome(order) and value.IsSome(col.Sort) and order.By == col.Sort
    title = if value.IsText(col.Title) col.Title else shown(col.Title) end
    if head > 0
      tw = widthOf(title, small, "body", u)
      hx = if rights[c] cw[c] - 10 - tw - (14 if sorted else 0) else 10 end
      hs = [words(hx, math.Div(head - lineOf(small, u), 2), title, small, k.Icon if not sorted else k.FgStrong)]
      if sorted
        hs = list.Append(iconItem(hx + tw + 2, math.Div(head - 12, 2), "arrow-down" if order.Desc else "arrow-up", 12, k.FgStrong), hs)
      end
      items = list.Append(group(x, 0, cw[c], head, true, hs), items)
    end
    if not phone
      cells = [lines[first + j - 1].Cells[c] for j in 1..value.Len(slice)]
      rows = list.Append(group(x, 0, cw[c], body, true, [group(0, -offset, cw[c], top, false, cells)]), rows)
    end
    x += cw[c]
  end
  if phone
    rows = list.Append(group(0, 0, inner, body, true, [group(0, -offset, inner, top, false, list.FlatMap(j -> lines[first + j - 1].Cells, 1..value.Len(slice)))]), rows)
  end
  items = list.Append(group(1, head, inner, body - 1, true, rows), items)
  if most > 0
    thumb = list.Max(20, math.Div(body * body, count * rh))
    y0 = head + math.Div((body - thumb) * offset, most)
    items = list.Append(rect(w - 8, y0 + 2, 6, thumb - 4, k.Hover, 3), items)
  end
  items = list.Append(frame(0, 0, w, h, k.Divider, 4), items)
  if u.Focus == id and u.Ring
    items = list.Concat(items, ringItems(w, h, t))
  end
  keep = if value.IsMissing(data) missing else {Ver: data.Ver, Order: order, Rows: data.Rows} end
  {Items: items, H: h, Cache: {Sorted: keep, First: first, Seen: seen, Count: count, Most: most, Offset: offset, Widths: cw, Row: rh, Head: head, Box: box,
    Texts: texts, Lines: lines, Rights: rights, Look: t, Phone: phone, Slice: slice}}
end

defn checkItems(x, y, on, t)
  (** A box to check at x, y, 14 pixels: checked, filled with the accent and a white check. *)
  k = t.Tokens
  if on
    return [rect(x, y, 14, 14, k.Primary, 3), iconItem(x + 1, y + 1, "check", 12, 0xffffff)]
  end
  [rect(x, y, 14, 14, k.Input, 3), frame(x, y, 14, 14, k.InputLineHigh, 3)]
end

defn cellItems(got, x, y, w, rh, ty, right, on, t, u, strong = false)
  (** The items of a cell at x, y (its row's), w wide: a pill, or its text in its font and color, white in the row
      chosen; a cell made of a text widget keeps its color. {Items, Text}. *)
  if isPill(got)
    p = pillItems(0, 0, shown(got.Text), got.Tone, dict.GetOr("Dot", true, got), t, u, on = on)
    px = if right w - 10 - p.W else 10 end
    return {Items: [group(x + px, y + math.Div(rh - p.H, 2), p.W, p.H, false, p.Items)], Text: shown(got.Text)}
  end
  (* the look has one face: numbers and amounts in it too, at the right of their column *)
  font = if strong "strong" else if fontOf(got) == "code" "body" else fontOf(got) end
  s = shown(got)
  own = if value.IsDict(got) and dict.Get("Kind", got) == "text" and value.IsSome(dict.Get("Color", got)) tone(got.Color, t) else missing end
  ink = if on t.ChosenInk else if value.IsSome(own) own else if font == "strong" role("Strong", t) else t.Ink end
  size = if value.IsDict(got) and dict.Get("Kind", got) == "text" and value.IsSome(dict.Get("Size", got)) sizeOf(got, t) else t.Size end
  cx = if right w - 10 - widthOf(s, size, font, u) else 10 end
  {Items: [withBytes(words(x + cx, y + math.Div(rh - lineOf(size, u), 2), s, size, ink, font))], Text: s}
end

defn tokenLine(i, row, on, lit, ticked, box, columns, cw, rights, inner, rh, ty, t, u, phone)
  (** The items of the row i of a table in a theme of tokens, as line gives them: {Row, On, Lit, Ticked, Back, Cells,
      Texts, Pure}. On a phone, Cells holds the items of the whole card. *)
  k = t.Tokens
  y = (i - 1) * rh
  alt = k.RowAlt
  hov = k.RowHover
  back = if on [rect(0, y, inner, rh, k.Select)]
    else if lit [{Kind: "rect", X: 0, Y: y, W: inner, H: rh, Color: hov[1], Radius: 0, Alpha: hov[2]}]
    else if math.Mod(i, 2) == 0 [{Kind: "rect", X: 0, Y: y, W: inner, H: rh, Color: alt[1], Radius: 0, Alpha: alt[2]}]
    else [] end
  if box > 0
    back = list.Concat(back, checkItems(11, y + math.Div(rh - 14, 2), ticked, t))
  end
  if phone and value.IsSome(row) and value.Len(columns) > 0
    return cardLine(i, row, on, back, columns, rights, inner, rh, t, u)
  end
  cells = []
  texts = []
  for c in 1..value.Len(columns)
    got = if value.IsMissing(row) "…" else columns[c].Cell(row) end
    one = cellItems(got, 0, y, cw[c], rh, ty, rights[c], on, t, u)
    cells = list.Append(if value.Len(one.Items) == 1 one.Items[1] else group(0, 0, cw[c], 0, false, one.Items) end, cells)
    texts = list.Append(one.Text, texts)
  end
  {Row: row, On: on, Lit: lit, Ticked: ticked, Back: back, Cells: cells, Texts: texts, Pure: true}
end

defn cardLine(i, row, on, back, columns, rights, inner, rh, t, u)
  (** A row of a table on a phone, as a card: its first two columns of text as its title, the other texts under it,
      its first amount (a column at the right) and its first pill at its right. *)
  y = (i - 1) * rh
  lh = lineOf(t.Size, u)
  cells = [columns[c].Cell(row) for c in 1..value.Len(columns)]
  texts = [if isPill(x) shown(x.Text) else shown(x) end for x in cells]
  lefts = [c for c in 1..value.Len(columns) if not rights[c] and not isPill(cells[c])]
  amount = list.FindFirst(c -> rights[c] and not isPill(cells[c]), 1..value.Len(columns))
  pill = list.FindFirst(c -> isPill(cells[c]), 1..value.Len(columns))
  side = 0
  out = []
  if value.IsSome(amount)
    s = texts[amount]
    sw = widthOf(s, t.Size, "strong", u)
    side = sw + 14
    out = list.Append(withBytes(words(inner - 14 - sw, y + 8, s, t.Size, t.ChosenInk if on else role("Strong", t), "strong")), out)
  end
  if value.IsSome(pill)
    p = pillItems(0, 0, texts[pill], cells[pill].Tone, dict.GetOr("Dot", true, cells[pill]), t, u, on = on)
    out = list.Append(group(inner - 14 - p.W, y + 8 + lh + 2, p.W, p.H, false, p.Items), out)
    side = list.Max(side, p.W + 14)
  end
  title = text.Join(" · ", [texts[c] for c in list.Take(2, lefts) if texts[c] != ""])
  sub = text.Join(" · ", [texts[c] for c in list.Skip(2, lefts) if texts[c] != ""])
  room = inner - 14 - side - 8
  out = list.Append(group(14, y + 8, room, lh, true, [words(0, 0, title, t.Size, t.ChosenInk if on else role("Strong", t), "strong")]), out)
  out = list.Append(group(14, y + 8 + lh, room, lh, true, [words(0, 0, sub, t.Size - 1, t.ChosenInk if on else t.Muted, "body")]), out)
  sep = rect(14, y + rh - 1, inner - 28, 1, t.Tokens.Divider)
  {Row: row, On: on, Lit: false, Ticked: false, Back: list.Append(sep, back), Cells: out, Texts: texts, Pure: true}
end

defn line(i, row, on, columns, cw, rights, inner, rh, ty, t, u)
  (** The items of the row i of a table at its place in the whole table: {Row, On, Back, Cells, Texts, Pure}, Back its
      background and its line, Cells the text of each column, Texts what they show, each item with its bytes, so that
      web.Encoded copies them as long as the row stays. A row not here yet shows "…". *)
  y = (i - 1) * rh
  back = [withBytes(one) for one in (if on [rect(0, y, inner, rh, t.Chosen), rect(0, y + rh - 1, inner, 1, t.Grid)] else [rect(0, y + rh - 1, inner, 1, t.Grid)] end)]
  cells = []
  texts = []
  ink = t.ChosenInk if on else t.Ink
  for c in 1..value.Len(columns)
    got = if value.IsMissing(row) "…" else columns[c].Cell(row) end
    font = fontOf(got)
    s = shown(got)
    cx = if rights[c] cw[c] - 6 - widthOf(s, t.Size, font, u) else 6 end
    cells = list.Append(withBytes(words(cx, y + ty, s, t.Size, ink, font)), cells)
    texts = list.Append(s, texts)
  end
  {Row: row, On: on, Back: back, Cells: cells, Texts: texts, Pure: true}
end

defn scrollTable(id, by, ui)
  (** Scrolls the table of box id by some pixels, within its rows. *)
  b = ui.Boxes[id]
  c = b.Cache
  most = if value.IsDict(c) and "Most" in c c.Most else 0 end
  Set(b.Node.Offset, list.Max(0, list.Min(Get(b.Node.Offset) + by, most)))
  ui
end

defn withBytes(one)
  (** A rect or a text of a table's row with its bytes as web.Encoded writes them (a text as a 9), in Enc. *)
  out = one
  out.Enc = text.FromNumbers("f32", if one.Kind == "text" [9, one.X, one.Y, one.Size, one.Color, 255, fonts[one.Font], text.ByteLength(one.Text), 0] else [1, one.X, one.Y, one.W, one.H, one.Color, 255, 0] end)
  out
end
