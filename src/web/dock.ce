(* The layout of a desktop tool: panels with tabs docked around a center, splitters between them, a toolbar, an
   outliner, an inspector and a status bar. A panel keeps its widgets when it moves: its body is made once, with its
   signals. Each of these widgets is given a height by the one around it, as a window gives its height to the page;
   inside a panel, what is taller than it scrolls. *)
use std/bug
use std/dict
use std/fiber
use std/json
use std/list
use std/math
use std/result
use std/text
use std/value

(* ---- Constructors *)

defn Panel(title, body, icon = missing, key = missing)
  (** A panel of a web.Dock or a web.Tabs: its title on its tab, beside an icon of web.Icons (each a value or a
      function that gives it, read again as the panel changes), and its body, a widget,
      4 pixels in, scrolled when it is taller than the panel; a body that fills the panel, as a table alone or a part
      that web.Grow marks in a stack, takes its height and doesn't scroll. key tells it apart in the layout that a
      dock keeps, its title by default (a title made by a function needs one).

        Panel("Log", Text("…"), icon = "output").Title --> "Log" *)
  {Kind: "panel", Title: title, Body: body, Icon: icon, Key: if value.IsMissing(key) title else key end,
    View: Scroll(Stack([Grow(body)], pad = 4, gap = 0))}
end

defn Scroll(item, height = missing)
  (** A widget in a place of a given height, a panel's or height pixels, that the wheel scrolls when it is taller:
      a thin bar at its right shows where it is.

        Scroll(Text("a")).Kind --> "scroll" *)
  {Kind: "scroll", Kids: [kid(item)], Offset: Signal(0), Height: height, Kit: kit}
end

defn Tabs(panels, chosen = 1, label = "")
  (** Panels one over the other, the tabs of their titles above: a click on a tab shows its panel, and so do Left and
      Right while the tabs have the focus. label names them for a screen reader.

        Tabs([Panel("A", "a"), Panel("B", "b")]).Kind --> "tabs" *)
  tabsOf(panels, Signal(chosen), label, missing, missing)
end

defn tabsOf(panels, chosen, label, dock, area)
  (** The node of a group of tabs, of an area of a dock or of none. Its one child shows the body of the chosen panel. *)
  ps = [p for p in panels]
  {Kind: "tabs", Panels: ps, Chosen: chosen, Label: label, Dock: dock, Area: area,
    Kids: [{Kind: "live", Fn: () -> shownPanel(ps, chosen)}], Kit: kit}
end

defn shownPanel(panels, chosen)
  (** The body of the chosen panel of a group, in its scroll, or nothing. *)
  if value.IsEmpty(panels)
    return missing
  end
  panels[list.Max(1, list.Min(value.Len(panels), Get(chosen)))].View
end

defn Split(first, second, along = "row", size = 240, sized = "first", min = 60)
  (** Two widgets side by side (along = "row") or one over the other ("column"), and a handle between them that the
      mouse drags: the part that sized names, "first" or "second", is size pixels wide (or tall), the other takes the
      rest. Neither gets less than min pixels.

        Split(Text("a"), Text("b")).Kind --> "split" *)
  splitOf(first, second, along, Signal(size), min, sized == "second", missing)
end

splitOf(first, second, along, size, min, last, dock) = {Kind: "split", Kids: [kid(first), kid(second)], Along: along, Size: size, Min: min, Last: last, Dock: dock, Kit: kit}

defn Dock(center, left = [], right = [], bottom = [], toolbar = missing, status = missing, key = missing, sizes = {})
  (** The layout of a desktop tool, which fills the window: a toolbar on top, a status bar at the bottom, and between
      them areas of panels (web.Panel), each a group of tabs, with splitters between them: left, the center, right,
      and bottom under the center. A tab dragged onto another area moves its panel there, or onto the edge of an area
      that is empty, which opens it. With key, the layout is kept on the machine, as the browser keeps a page's data
      (and in a window, in the folder of the app's data): the size of each area, the panels of each and the one shown,
      found again the next time. sizes gives the sizes at first, {Left: 240, Right: 320, Bottom: 200} by default.
      The bottom area folds to its tabs while the panel it shows has nothing to show but a web.Empty, and opens when
      something comes; Ctrl+J, Enter on its tabs or the arrow at their right folds it or opens it by hand, which the
      layout keeps.

        Dock([Panel("Main", "…")], key = "admin").Kind --> "dock" *)
  all = list.Concat(list.Concat(center, left), list.Concat(right, bottom))
  panels = dict.Dict()
  for p in all
    panels[p.Key] = p
  end
  areas = {Left: [p.Key for p in left], Center: [p.Key for p in center], Right: [p.Key for p in right], Bottom: [p.Key for p in bottom]}
  state = {Id: fresh(), Key: key, Panels: panels, Areas: Signal(areas), First: areas,
    Sizes: {Left: Signal(dict.GetOr("Left", 240, sizes)), Right: Signal(dict.GetOr("Right", 320, sizes)), Bottom: Signal(dict.GetOr("Bottom", 200, sizes))},
    Chosen: {Left: Signal(1), Center: Signal(1), Right: Signal(1), Bottom: Signal(1)}, Fold: Signal(missing)}
  top = if value.IsMissing(toolbar) missing else kid(toolbar) end
  foot = if value.IsMissing(status) missing else kid(status) end
  {Kind: "dock", State: state, Top: value.IsSome(top), Foot: value.IsSome(foot),
    Kids: kids([top, {Kind: "live", Fn: () -> dockBody(state)}, foot]), Kit: kit}
end

defn dockBody(st)
  (** The areas of a dock as splits of groups of tabs, as its layout says: an area without panels takes no room. *)
  areas = Get(st.Areas)
  tabs = defn (area)
    tabsOf([st.Panels[n] for n in areas[area]], st.Chosen[area], area, st, area)
  end
  has = a -> not value.IsEmpty(areas[a])
  middle = if has("Bottom") splitOf(tabs("Center"), tabs("Bottom"), "column", st.Sizes.Bottom, 60, true, st) else tabs("Center") end
  wide = if has("Right") splitOf(middle, tabs("Right"), "row", st.Sizes.Right, 120, true, st) else middle end
  if has("Left") splitOf(tabs("Left"), wide, "row", st.Sizes.Left, 120, false, st) else wide end
end

defn Toolbar(items)
  (** A toolbar: buttons with an icon, their label and their key, flat until the mouse is over one; a web.Spacer
      pushes the next to the right, a web.Divider is a thin line up between two groups.

        Toolbar([Button("Save", () -> missing, icon = "save", key = "C-s")]).Kind --> "toolbar" *)
  {Kind: "toolbar", Kids: [barred(x) for x in kids(items)], Gap: 4, Pad: 4, Fill: "Band", Border: missing, Radius: 0, Width: missing,
    Height: missing, Align: "center", Grow: 0, Kit: kit}
end

defn barred(w)
  (** A child of a toolbar or a status bar: a button drawn flat, a divider as a line up. *)
  if w.Kind == "button"
    out = w
    out.Flat = true
    return out
  end
  if w.Kind == "divider" {Kind: "sep", Kit: kit} else w end
end

defn StatusBar(items)
  (** The status bar at the bottom of a dock: short texts, as the state of the connection, who is signed in and
      counts, a web.Spacer between those at the left and those at the right, a web.Divider a line up between two.

        StatusBar(["Ready"]).Kind --> "statusbar" *)
  {Kind: "statusbar", Kids: [barred(x) for x in kids(items)], Gap: 12, Pad: 4, Fill: "Band", Border: missing, Radius: 0, Width: missing,
    Height: missing, Align: "center", Grow: 0, Kit: kit}
end

defn Item(label, icon = missing, kids = [], on = missing, count = missing, key = missing, to = missing, tone = missing)
  (** A row of a web.Tree or a web.Nav: its label, an icon of web.Icons, the rows under it, on(), what choosing it
      does, a count shown at its right, in the color tone (a role of the theme, as "Danger" for "1 failed"), and key,
      what tells it apart, its label by default. to, a route of the app, makes the row a link to it: choosing it goes
      there, as web.Go does, and in a browser Ctrl or the middle button opens it in a new tab.

        Item("Users", icon = "person", count = 7).Count --> 7
        Item("Users", to = "/users").To --> "/users" *)
  {Label: label, Icon: icon, Kids: kids, On: on, Count: count, Key: if value.IsMissing(key) label else key end, To: to, Tone: tone}
end

defn Tree(items, chosen = missing, closed = [], label = "")
  (** An outliner: rows of web.Item under rows, each under its parent and further in; a triangle opens or closes a
      row that has some, and a click chooses a row, which runs its on(). items is a list, a signal of one or a
      function, a live part; chosen is the key of the row chosen at first, closed those of the rows closed at first.
      Up and Down choose the row above or under, Left closes a row or goes to its parent, Right opens it, Enter runs
      it. label names it for a screen reader.

        Tree([Item("Data", kids = [Item("Invoices")])]).Kind --> "tree" *)
  shut = dict.Dict()
  for k in closed
    shut[k] = true
  end
  {Kind: "tree", Items: items, Chosen: Signal(chosen), Closed: Signal(shut), Label: label, Kit: kit}
end

defn Section(title, rows, open = true)
  (** A part of an inspector under its title, which a click opens or closes, as Enter or Space does while it has the
      focus: rows are widgets, web.Property for most.

        Section("Fields", []).Kind --> "stack" *)
  shown = Signal(open)
  Stack([{Kind: "section", Title: title, Open: shown, Kit: kit}, () -> if Get(shown) Stack(rows, gap = 2, pad = 4) else missing end], gap = 0)
end

defn Property(label, editor, note = missing, error = missing, width = 112)
  (** A row of an inspector: a label at the left, in a column of width pixels, and its editor, a web.Input or any
      widget, which a field fills to the right; note, a short text after it in a column of 56 pixels, as the type of a
      field, in the muted color; error, a function that gives the text of what is wrong with it ("" or missing for nothing), shown under it
      in the color of danger.

        Property("Total", Input(Signal("12"))).Kind --> "row" *)
  ed = kid(editor)
  if (ed.Kind == "input" or ed.Kind == "select") and value.IsMissing(ed.Width)
    ed.Width = 100000
  end
  line = Row([Stack([Text(label, color = "Muted")], width = width), Grow(Stack([ed], gap = 0)), if value.IsMissing(note) missing else Stack([Text(note, color = "Muted")], width = 56) end], gap = 8)
  if value.IsMissing(error) line else Stack([line, () -> wrongText(error())], gap = 2) end
end

wrongText(s) = if value.IsMissing(s) or s == "" missing else Text(s, color = "Danger") end   (* The error of a property, if any. *)

defn Empty(title, about, action = missing, icon = missing)
  (** What a place with nothing in it yet shows, in its middle: icon, a name of web.Icons, in the muted color; title,
      which says so in a few words ("No events yet"); about, what goes here and where it comes from; and action, a
      web.Button that fills it, its key beside its label. The bottom panels of a web.Dock fold to their tabs while the
      one shown has only this to show, its title at their right, until something comes or the person opens them.

        Empty("No events yet", "Sign-ins and changes show here as they happen.").Empty --> "No events yet" *)
  parts = [if value.IsMissing(icon) missing else Icon(icon, color = "Muted") end, Text(title, font = "strong"), Text(about, color = "Muted"), action]
  out = Stack(parts, gap = 6, pad = 12, align = "center")
  out.Empty = title
  out
end

defn Inspector(sections, label = "")
  (** The properties of a thing, as a desktop tool's details panel: sections (web.Section) of rows (web.Property),
      their labels in one column, dense, each field edited in place.

        Inspector([]).Kind --> "stack" *)
  Stack(sections, gap = 4)
end

(* ---- The kit: what the rest of Ceres calls of these widgets. Each of them carries kit, and the page takes it as it
   mounts the first (u.Kit); the layout, the semantics, the patch and the events call them through it. So a page
   that makes none of them never reaches their code, and its module holds none of it: the build of WebAssembly links
   only what a page can reach. *)

defn kit()
  (** The functions of the widgets of a desktop tool, as a page calls them. *)
  {Lay: layDesk, Mounted: restored, Sem: semDesk, Patch: patchDesk, Drop: dropItems, Hover: hoverDesk, Down: dockDown,
    Drag: dockDrag, Up: dockUp, Wheel: wheelDesk, Reveal: reveal, Key: keyDesk, Fold: foldKey, Pane: paneTo, Modal: shellModal}
end

defn layDesk(id, maxW, ui)
  (** Lays out a widget of a desktop tool in maxW pixels, as layout does the others. *)
  k = ui.Boxes[id].Node.Kind
  if k == "dock" layDock(id, maxW, ui)
  else if k == "split" laySplit(id, maxW, ui)
  else if k == "tabs" layTabs(id, maxW, ui)
  else if k == "scroll" layScroll(id, maxW, ui)
  else if k == "tree" layTree(id, maxW, ui)
  else if k == "section" laySection(id, maxW, ui)
  else if k == "icon" layIcon(id, ui)
  else if k == "sep" layLine(id, ui)
  else if k == "shell" layShell(id, maxW, ui)
  else if k == "side" laySide(id, maxW, ui)
  else if k == "inset" layInset(id, maxW, ui)
  else if k == "narrow" layNarrow(id, maxW, ui)
  else if k == "sheet" laySheet(id, maxW, ui)
  else if k == "pop" layPop(id, maxW, ui)
  else if k == "picks" layPicks(id, maxW, ui)
  else if k == "nav" layNav(id, maxW, ui)
  else if k == "header" layHeader(id, maxW, ui)
  else if k == "chips" layChips(id, maxW, ui)
  else if k == "pill" layPill(id, ui)
  else if k == "asked" layAsked(id, maxW, ui)
  else if k == "strip" layStrip(id, maxW, ui)
  else if k == "metric" layMetric(id, maxW, ui)
  else bug.Panic("No layout for the widget kind $k.") end
end

(* ---- Layout: each of these is given its height by the one around it (layout's h), as a panel gives its own. *)

fillKinds = ["dock", "split", "tabs", "scroll", "shell", "sheet", "side"]   (* The kinds that take the height they are given. *)

defn grows(id, u)
  (** Does the box id take a share of the height left in a stack: web.Grow marks it, or it is a spacer of no size? *)
  n = u.Boxes[id].Node
  dict.GetOr("Grow", 0, n) > 0 and (n.Kind != "spacer" or n.Size == 0)
end

defn fills(id, u)
  (** Does the box id take the height it is given, rather than its own: a dock, a split, tabs, a scroll, a table or a
      stack with a part that grows, or a live part that gives one of those? *)
  b = u.Boxes[id]
  k = b.Node.Kind
  if k in fillKinds
    return true
  end
  if k == "live"
    return not value.IsEmpty(b.Kids) and fills(b.Kids[1], u)
  end
  if k == "table"
    return dict.GetOr("Grow", 0, b.Node) > 0
  end
  k == "stack" and value.Len([c for c in b.Kids if grows(c, u)]) > 0
end

defn pageFills(u)
  (** Is the page a dock, which fills the window edge to edge? *)
  r = u.Boxes[u.Root]
  if value.IsEmpty(r.Kids)
    return false
  end
  live = u.Boxes[r.Kids[1]]
  if live.Node.Kind in ["dock", "shell"]
    return true
  end
  live.Node.Kind == "live" and not value.IsEmpty(live.Kids) and u.Boxes[live.Kids[1]].Node.Kind in ["dock", "shell"]
end

iconItem(x, y, name, size, color) = {Kind: "text", X: x, Y: y, Text: glyph(name), Size: size, Color: color, Font: "icon", Icon: name}   (* An icon as a draw item. *)

defn layIcon(id, ui)
  n = ui.Boxes[id].Node
  t = ui.Theme
  s = if value.IsMissing(n.Size) role("Icon", t) else n.Size end
  sized(id, s, s, [iconItem(0, 0, n.Name, s, if value.IsMissing(n.Color) t.Ink else tone(n.Color, t) end)], ui)
end

layLine(id, ui) = sized(id, 1, 16, [rect(0, 0, 1, 16, role("Edge", ui.Theme))], ui)   (* A line up between two groups of a toolbar. *)

defn laySplit(id, maxW, ui)
  (** Two parts and the handle between them, each part cut to its place. *)
  b = ui.Boxes[id]
  n = b.Node
  row = n.Along == "row"
  bottom = value.IsSome(n.Dock) and not row and n.Last
  got = watched(id, () -> {Size: Get(n.Size), Fold: if bottom Get(n.Dock.Fold) else missing end}, ui)
  u = got.Ui
  t = u.Theme
  gap = role("Unit", t)
  h0 = if value.IsSome(b.Gh) b.Gh else if row missing else 2 * got.Value.Size + gap end
  total = (maxW if row else h0) - gap
  lo = list.Min(n.Min, math.Div(total, 2))
  folded = bottom and (if value.IsBool(got.Value.Fold) got.Value.Fold else value.IsSome(shownEmpty(b.Kids[2], u)) end)
  s = if folded list.Min(total, role("Tab", t)) else list.Max(lo, list.Min(total - lo, got.Value.Size)) end
  if bottom
    u.Foldable = id
  end
  a = total - s if n.Last else s
  c = total - a
  k1 = b.Kids[1]
  k2 = b.Kids[2]
  u = layout(k1, a if row else maxW, false, u, h = h0 if row else a)
  u = layout(k2, c if row else maxW, false, u, h = h0 if row else c)
  hh = if value.IsSome(h0) h0 else list.Max(u.Boxes[k1].H, u.Boxes[k2].H) end
  u = place(k1, 0, 0, u)
  u = place(k2, a + gap if row else 0, 0 if row else a + gap, u)
  handle = if row [a, 0, gap, hh] else [0, a, maxW, gap] end
  hot = u.Hover == id or value.IsSome(u.Drag) and dict.Get("Box", u.Drag) == id
  own = if hot [rect(handle[1], handle[2], handle[3], handle[4], t.Accent)] else [] end
  b1 = u.Boxes[k1]
  b2 = u.Boxes[k2]
  parts = [group(0, 0, a if row else maxW, hh if row else a, true, b1.Items), group(b2.X, b2.Y, c if row else maxW, hh if row else c, true, b2.Items)]
  boxed(id, maxW, hh, list.Concat(own, parts), {Handle: handle, Room: total, Size: s, Row: row, Folded: folded}, u)
end

defn shownEmpty(id, u)
  (** The web.Empty that the box id shows and nothing else, through the parts that hold one child each (the tabs of an
      area, its panel's scroll, a live part), or missing. *)
  b = u.Boxes[id]
  e = dict.Get("Empty", b.Node)
  if value.IsSome(e)
    return e
  end
  k = b.Node.Kind
  if (k == "tabs" or k == "live" or k == "scroll" or k == "stack" or k == "row") and value.Len(b.Kids) == 1
    return shownEmpty(b.Kids[1], u)
  end
  missing
end

defn folding(u)
  (** The split of the bottom area of the page's dock, its id and whether it is folded: {Id, Folded}, or missing. *)
  id = dict.GetOr("Foldable", 0, u)
  if id == 0 or not (id in u.Boxes) or u.Boxes[id].Node.Kind != "split"
    return missing
  end
  {Id: id, Folded: dict.GetOr("Folded", false, u.Boxes[id].Cache)}
end

defn areaTabs(st, area, u)
  (** The box of the tabs of an area of a dock, or 0. *)
  for id in dict.Keys(u.Boxes)
    n = u.Boxes[id].Node
    if n.Kind == "tabs" and value.IsSome(n.Dock) and n.Dock.Id == st.Id and n.Area == area
      return id
    end
  end
  0
end

defn paneTo(back, ui)
  (** F6 and Shift+F6: the focus to the next area of the page's dock, or the one before, column after column as Tab
      goes (left, center, bottom, right): on the first widget of its panel that takes it, else on its tabs. The page
      after, or missing when it has no dock. *)
  docks = [id for id in dict.Keys(ui.Boxes) if ui.Boxes[id].Node.Kind == "dock"]
  if value.IsEmpty(docks)
    return missing
  end
  st = ui.Boxes[docks[1]].Node.State
  areas = [a for a in ["Left", "Center", "Bottom", "Right"] if areaTabs(st, a, ui) != 0]
  if value.IsEmpty(areas)
    return missing
  end
  here = list.FindFirst(a -> holdsFocus(areaTabs(st, a, ui), ui), areas)
  i = if value.IsMissing(here) (value.Len(areas) if back else 0) else list.IndexOf(here, areas) end
  j = math.Mod(i - 1 + (-1 if back else 1) + value.Len(areas), value.Len(areas)) + 1
  tabs = areaTabs(st, areas[j], ui)
  inside = [k for k in focusables(tabs, ui) if k != tabs]
  focus(if value.IsEmpty(inside) tabs else inside[1] end, ui, ring = true)
end

defn foldKey(ui)
  (** Ctrl+J: folds the bottom area of the page's dock, or opens it, by hand: whether there was one. *)
  f = folding(ui)
  if value.IsMissing(f)
    return false
  end
  st = ui.Boxes[f.Id].Node.Dock
  Set(st.Fold, not f.Folded)
  _ = keepDock(st, ui)
  true
end

defn layScroll(id, maxW, ui)
  (** Its child at its scroll, cut to the place, and a thin bar at the right when it is taller. *)
  b = ui.Boxes[id]
  n = b.Node
  got = watched(id, () -> Get(n.Offset), ui)
  u = got.Ui
  t = u.Theme
  h = if value.IsSome(b.Gh) b.Gh else if value.IsSome(n.Height) n.Height else 300 end
  c = b.Kids[1]
  u = layout(c, maxW, false, u, h = h if fills(c, u) else missing)
  ch = u.Boxes[c].H
  most = list.Max(0, ch - h)
  off = list.Max(0, list.Min(most, got.Value))
  u = place(c, 0, -off, u)
  over = []
  if most > 0
    bar = list.Max(20, math.Div(h * h, ch))
    over = [rect(maxW - 6, math.Div((h - bar) * off, most), 4, bar, t.Line, radius = 2)]
  end
  wrap = group(0, 0, maxW, h, true, [group(0, -off, u.Boxes[c].W, ch, false, u.Boxes[c].Items)])
  boxed(id, maxW, h, list.Concat([wrap], over), {Most: most, Offset: off, Seen: h}, u, over = value.Len(over), wrap = true)
end

defn layTabs(id, maxW, ui)
  (** The strip of the tabs, the chosen one the color of the panel under it, and the chosen panel's body. *)
  b = ui.Boxes[id]
  n = b.Node
  got = watched(id, () -> Get(n.Chosen), ui)
  u = got.Ui
  t = u.Theme
  th = role("Tab", t)
  h = if value.IsSome(b.Gh) b.Gh else 300 end
  ps = n.Panels
  chosen = list.Max(1, list.Min(value.Len(ps), got.Value))
  c = b.Kids[1]
  u = layout(c, maxW, false, u, h = h - th)
  u = place(c, 0, th, u)
  inside = holdsFocus(id, u)
  lh = lineOf(t.Size, u)
  ic = role("Icon", t)
  items = [rect(0, 0, maxW, th, tok("Desk", t, "Header")), rect(0, th, maxW, h - th, role("Panel", t))]
  x = 0
  spans = []
  titles = []
  for k in 1..value.Len(ps)
    p = ps[k]
    title = shown(p.Title)
    icon = valueOf(p.Icon)
    iw = if value.IsMissing(icon) 0 else ic + 6 end
    tw = 24 + iw + widthOf(title, t.Size, "body", u)
    on = k == chosen
    hov = u.Hover == id and u.HoverPart == k
    if on
      items = list.Append(rect(x, 0, tw, th, role("Panel", t)), items)
      items = list.Append(rect(x, 0, tw, 2, t.Accent if inside else role("Edge", t)), items)
    else if hov
      items = list.Append(rect(x, 2, tw, th - 2, role("Hover", t)), items)
    end
    ink = t.Ink if on or hov else tok("TabOff", t, "Muted")
    if value.IsSome(icon)
      items = list.Append(iconItem(x + 12, math.Div(th - ic, 2), icon, ic, t.Link if on and inside else ink), items)
    end
    items = list.Append(words(x + 12 + iw, math.Div(th - lh, 2), title, t.Size, ink), items)
    if on and u.Focus == id and u.Ring
      items = list.Append(frame(x + 1, 1, tw - 2, th - 2, t.Accent), items)
    end
    spans = list.Append([x, tw], spans)
    titles = list.Append(title, titles)
    x += tw + 1
  end
  fold = missing
  if n.Area == "Bottom"
    (* the arrow that folds the area or opens it, and while folded, what its panel would say *)
    shut = h <= th
    fx = maxW - ic - 8
    fold = [fx - 4, ic + 8]
    items = list.Append(iconItem(fx, math.Div(th - ic, 2), "chevron-up" if shut else "chevron-down", ic, tok("TabOff", t, "Muted")), items)
    e = if shut shownEmpty(c, u) else missing end
    if value.IsSome(e)
      say = shown(e)
      ex = list.Max(x + 12, fx - 12 - widthOf(say, t.Size, "body", u))
      items = list.Append(group(ex, 0, fx - 12 - ex, th, true, [words(0, math.Div(th - lh, 2), say, t.Size, tok("TabOff", t, "Muted"))]), items)
    end
  end
  items = list.Append(group(0, th, maxW, h - th, true, u.Boxes[c].Items), items)
  boxed(id, maxW, h, items, {Spans: spans, Titles: titles, Tab: th, Chosen: chosen, Fold: fold, Shut: h <= th}, u)
end

defn holdsFocus(id, u)
  (** Is the widget in focus the box id or inside it? *)
  k = u.Focus
  while k != 0 and k in u.Boxes
    return true if k == id
    k = u.Boxes[k].Parent
  end
  false
end

defn layDock(id, maxW, ui)
  (** The toolbar on top, the status bar at the bottom, the areas between, the window's color in the gaps. *)
  u = ui
  b = u.Boxes[id]
  n = b.Node
  t = u.Theme
  gap = role("Unit", t)
  h = if value.IsSome(b.Gh) b.Gh else seenHeight(u) - (0 if pageFills(u) else 2 * t.Page) end
  ks = b.Kids
  top = 0
  i = 1
  if n.Top
    u = layout(ks[1], maxW, false, u)
    u = place(ks[1], 0, 0, u)
    top = u.Boxes[ks[1]].H + gap
    i = 2
  end
  foot = 0
  if n.Foot
    f = ks[i + 1]
    u = layout(f, maxW, false, u)
    foot = u.Boxes[f].H + gap
    u = place(f, 0, h - u.Boxes[f].H, u)
  end
  body = ks[i]
  bh = list.Max(0, h - top - foot)
  u = layout(body, maxW, false, u, h = bh)
  u = place(body, 0, top, u)
  parts = [group(u.Boxes[k].X, u.Boxes[k].Y, maxW, bh if k == body else u.Boxes[k].H, k == body, u.Boxes[k].Items) for k in ks]
  boxed(id, maxW, h, list.Prepend(rect(0, 0, maxW, h, t.Back), parts), {Body: body, Top: top, Height: bh}, u)
end

defn itemsOf(n)
  (** The items of a tree: a list, a signal's or a live part's. *)
  x = n.Items
  if value.IsFunction(x) x() else if isSignal(x) Get(x) else x end
end

defn rowsOf(items, closed, level)
  (** The rows in sight of a tree, each {Item, Level, Kids, Open}: the rows under a closed one left out. *)
  out = []
  for one in items
    has = not value.IsEmpty(one.Kids)
    open = not (one.Key in closed)
    out = list.Append({Item: one, Level: level, Kids: has, Open: has and open}, out)
    if has and open
      out = list.Concat(out, rowsOf(one.Kids, closed, level + 1))
    end
  end
  out
end

defn layTree(id, maxW, ui)
  (** The rows of an outliner, one under the other: further in for each level, a triangle before those that have rows
      under them, the chosen row in the color of the choice, the row under the mouse lighter. A row that is a link to
      the route shown is the one chosen, so that Back and Forward move the choice with the page. *)
  b = ui.Boxes[id]
  n = b.Node
  got = watched(id, () -> {Items: itemsOf(n), Chosen: Get(n.Chosen), Closed: Get(n.Closed), Path: if value.IsSome(ui.Nav) Get(ui.Nav) else missing end}, ui)
  u = got.Ui
  t = u.Theme
  rows = rowsOf(got.Value.Items, got.Value.Closed, 1)
  linked = if value.IsMissing(got.Value.Path) missing else list.FindFirst(r -> dict.Get("To", r.Item) == got.Value.Path, rows) end
  chosen = if value.IsSome(linked) linked.Item.Key else got.Value.Chosen end
  rh = t.Row
  lh = lineOf(t.Size, u)
  ic = role("Icon", t)
  ty = math.Div(rh - lh, 2)
  iy = math.Div(rh - ic, 2)
  items = []
  for k in 1..value.Len(rows)
    r = rows[k]
    one = r.Item
    y = (k - 1) * rh
    on = one.Key == chosen
    if on
      items = list.Append(rect(0, y, maxW, rh, t.Chosen), items)
    else if u.Hover == id and u.HoverPart == k
      items = list.Append(rect(0, y, maxW, rh, role("Hover", t)), items)
    end
    ink = t.ChosenInk if on else t.Ink
    soft = t.ChosenInk if on else t.Muted
    x = 4 + (r.Level - 1) * 14
    if r.Kids
      items = list.Append(iconItem(x, y + iy, "chevron-down" if r.Open else "chevron-right", ic, soft), items)
    end
    x += ic + 2
    if value.IsSome(one.Icon)
      items = list.Append(iconItem(x, y + iy, one.Icon, ic, ink if on else t.Muted), items)
      x += ic + 6
    end
    items = list.Append(words(x, y + ty, shown(one.Label), t.Size, ink), items)
    if value.IsSome(one.Count)
      s = shown(one.Count)
      items = list.Append(words(maxW - 8 - widthOf(s, t.Size, "code", u), y + ty, s, t.Size, soft, "code"), items)
    end
  end
  if u.Focus == id and u.Ring
    items = list.Append(frame(0, 0, maxW, list.Max(rh, value.Len(rows) * rh), t.Accent), items)
  end
  cached(id, maxW, list.Max(rh, value.Len(rows) * rh), items, {Rows: rows, Row: rh, Chosen: chosen, Text: n.Label}, u)
end

defn laySection(id, maxW, ui)
  (** The title of a section of an inspector, on a band, a triangle before it that says whether it is open. *)
  n = ui.Boxes[id].Node
  got = watched(id, () -> Get(n.Open), ui)
  u = got.Ui
  t = u.Theme
  h = t.Row + 2
  ic = role("Icon", t)
  title = shown(n.Title)
  items = [rect(0, 0, maxW, h, role("Hover", t) if u.Hover == id else role("Header", t)),
    iconItem(4, math.Div(h - ic, 2), "chevron-down" if got.Value else "chevron-right", ic, t.Muted),
    words(8 + ic, math.Div(h - lineOf(t.Size, u), 2), title, t.Size, t.Ink, "strong")]
  if u.Focus == id and u.Ring
    items = list.Append(frame(0, 0, maxW, h, t.Accent), items)
  end
  cached(id, maxW, h, items, {Text: title, Open: got.Value}, u)
end

(* ---- The mouse and the keys *)

defn tabAt(x, y, b)
  (** The tab of a group of tabs at x, y in its box, or missing. *)
  c = b.Cache
  if y >= c.Tab
    return missing
  end
  for k in 1..value.Len(c.Spans)
    s = c.Spans[k]
    return k if x >= s[1] and x < s[1] + s[2]
  end
  missing
end

defn rowAt(y, b)
  (** The row of a tree at y in its box, or missing. *)
  k = math.Div(y, b.Cache.Row) + 1
  if k >= 1 and k <= value.Len(b.Cache.Rows) k else missing end
end

defn onHandle(h, b)
  (** Is the point h, in the box b of a split, on its handle? *)
  hh = b.Cache.Handle
  h.X >= hh[1] and h.X < hh[1] + hh[3] and h.Y >= hh[2] and h.Y < hh[2] + hh[4]
end

defn hoverDesk(h, ui)
  (** What the mouse is over in a widget of a desktop tool, h in its box: {Id, Part, Cursor}, the box it lights and its
      part (a tab, a row of a tree), and the cursor, as a split's handle that a press drags. *)
  b = ui.Boxes[h.Id]
  k = b.Node.Kind
  if k == "split" and onHandle(h, b)
    return {Id: h.Id, Part: missing, Cursor: "col-resize" if b.Cache.Row else "row-resize"}
  else if k == "tabs"
    part = tabAt(h.X, h.Y, b)
    return {Id: if value.IsSome(part) h.Id else 0 end, Part: part, Cursor: "default"}
  else if k == "tree"
    return {Id: h.Id, Part: rowAt(h.Y, b), Cursor: "default"}
  end
  shellHover(h, ui)
end

defn wheelDesk(id, by, ui)
  (** The wheel over the box id scrolls the nearest panel above it that has more than it shows, by pixels: whether
      one did. *)
  s = scrollAbove(id, ui)
  if s == 0
    return false
  end
  n = ui.Boxes[s].Node
  c = ui.Boxes[s].Cache
  Set(n.Offset, list.Max(0, list.Min(c.Most, Get(n.Offset) + by)))
  true
end

defn keyDesk(e, ui)
  (** A key for the widget of a desktop tool in focus: a tree's, tabs', or PgUp and PgDn on a button or a section,
      which scroll its panel. *)
  k = ui.Boxes[ui.Focus].Node.Kind
  if k == "tree" treeKey(e, ui) else if k == "tabs" tabsKey(e, ui) else if k == "nav" or k == "chips" shellKey(e, ui) else paneKey(e, ui) end
end

defn dockDown(h, e, ui)
  (** A press on a split's handle starts to drag it, on a tab shows its panel and may start to drag it to another
      area, on a row of a tree chooses it or opens it. *)
  u = ui
  b = u.Boxes[h.Id]
  k = b.Node.Kind
  if k == "split"
    if not onHandle(h, b)
      return focus(0, u)
    end
    u.Drag = {Kind: "split", Box: h.Id, At: e.X if b.Cache.Row else e.Y, Size: b.Cache.Size}
    return touch(h.Id, u)
  else if k == "tabs"
    fold = dict.Get("Fold", b.Cache)
    if value.IsSome(fold) and h.Y < b.Cache.Tab and h.X >= fold[1] and h.X < fold[1] + fold[2]
      Set(b.Node.Dock.Fold, not b.Cache.Shut)
      return keepDock(b.Node.Dock, u)
    end
    i = tabAt(h.X, h.Y, b)
    if value.IsMissing(i)
      return u
    end
    if value.IsSome(fold) and b.Cache.Shut
      Set(b.Node.Dock.Fold, false)
    end
    Set(b.Node.Chosen, i)
    u = keepDock(b.Node.Dock, focus(h.Id, u))
    u.Drag = {Kind: "tab", Box: h.Id, Index: i, X: e.X, Y: e.Y, Moved: false}
    return u
  else if k == "tree"
    return treeDown(h, u)
  else if k in ["nav", "chips", "picks", "asked"]
    return shellDown(h, e, u)
  end
  focus(0, u)
end

defn dockDrag(d, e, ui)
  (** The mouse moves while it drags a split's handle, which moves with it, or a tab, whose panel would go to the
      area under it, which shows lit. *)
  u = ui
  b = u.Boxes[d.Box]
  n = b.Node
  if d.Kind == "split"
    moved = (e.X if b.Cache.Row else e.Y) - d.At
    if dict.GetOr("Folded", false, b.Cache) and moved != 0
      (* the handle of a folded bottom area, dragged: the area opens by hand, from the size it had *)
      Set(n.Dock.Fold, false)
      return u
    end
    Set(n.Size, list.Max(0, d.Size + (0 - moved if n.Last else moved)))
    return u
  end
  if not d.Moved and math.Abs(e.X - d.X) + math.Abs(e.Y - d.Y) <= 6
    return u
  end
  dd = d
  dd.Moved = true
  u.Drag = dd
  u.Cursor = "grabbing"
  target = dropAt(e.X, e.Y, d.Box, u)
  if not value.Equal(target, u.Drop)
    u.Drop = target
    u.Changed = true
  end
  u
end

defn dockUp(d, e, ui)
  (** The mouse comes up after a drag: a split keeps its new size, a tab dropped onto another area moves its panel
      there; the dock keeps its layout. *)
  u = ui
  if not (d.Box in u.Boxes)
    return u
  end
  b = u.Boxes[d.Box]
  n = b.Node
  if d.Kind == "split"
    Set(n.Size, b.Cache.Size)
    return keepDock(n.Dock, touch(d.Box, u))
  end
  drop = u.Drop
  u.Drop = missing
  u.Changed = true
  u.Cursor = "default"
  if not d.Moved or value.IsMissing(drop)
    return u
  end
  movePanel(n.Dock, n.Panels[d.Index].Key, n.Area, drop.Area)
  keepDock(n.Dock, u)
end

defn movePanel(st, key, from, to)
  (** Moves the panel key of a dock from an area to another, where it is then shown. *)
  areas = Get(st.Areas)
  areas[from] = [x for x in areas[from] if x != key]
  areas[to] = list.Append(key, areas[to])
  Set(st.Areas, areas)
  Set(st.Chosen[to], value.Len(areas[to]))
  Set(st.Chosen[from], list.Max(1, list.Min(Get(st.Chosen[from]), value.Len(areas[from]))))
end

defn above(id, kind, u)
  (** The nearest box of a kind at id or above it, or 0. *)
  k = id
  while k != 0 and k in u.Boxes
    return k if u.Boxes[k].Node.Kind == kind
    k = u.Boxes[k].Parent
  end
  0
end

defn scrollAbove(id, u)
  (** The nearest scroll at id or above it that has more than it shows, or 0. *)
  k = above(id, "scroll", u)
  while k != 0
    c = u.Boxes[k].Cache
    return k if value.IsDict(c) and c.Most > 0
    k = above(u.Boxes[k].Parent, "scroll", u)
  end
  0
end

defn reveal(id, u)
  (** Scrolls each panel that holds the box id, from the nearest out, so that it shows the box, as the focus moves
      there by the keyboard: the least that brings it in sight. *)
  s = above(u.Boxes[id].Parent, "scroll", u)
  while s != 0
    c = u.Boxes[s].Cache
    if value.IsDict(c) and c.Most > 0
      top = at(s, u).Y
      y = at(id, u).Y
      h = list.Min(u.Boxes[id].H, c.Seen)
      want = if y < top c.Offset - (top - y) else if y + h > top + c.Seen c.Offset + (y + h - top - c.Seen) else c.Offset end
      want = list.Max(0, list.Min(c.Most, want))
      if want != c.Offset
        Set(u.Boxes[s].Node.Offset, want)
      end
    end
    s = above(u.Boxes[s].Parent, "scroll", u)
  end
  u
end

defn paneKey(e, u)
  (** PgUp and PgDn while a button or a section of a panel has the focus: the panel scrolls by what it shows, less a
      line; the page does when no panel holds it. *)
  s = scrollAbove(u.Focus, u)
  if s == 0
    return pageKey(e, u)
  end
  c = u.Boxes[s].Cache
  by = (c.Seen - 48) * (1 if e.Key == "pagedown" else -1)
  Set(u.Boxes[s].Node.Offset, list.Max(0, list.Min(c.Most, c.Offset + by)))
  u
end

defn dropAt(x, y, src, u)
  (** Where a tab of the group src dropped at x, y of the window would go: {Area, X, Y, W, H}, the area and the place
      it lights, or missing. An empty area of the dock is at its edge, 48 pixels wide. *)
  st = u.Boxes[src].Node.Dock
  dk = above(src, "dock", u)
  if value.IsMissing(st) or dk == 0
    return missing
  end
  db = u.Boxes[dk]
  p = at(dk, u)
  top = p.Y + db.Cache.Top
  bh = db.Cache.Height
  if y < top or y >= top + bh
    return missing
  end
  areas = Get(st.Areas)
  from = u.Boxes[src].Node.Area
  edge = 48
  if value.IsEmpty(areas.Left) and x < p.X + edge
    return {Area: "Left", X: p.X, Y: top, W: Get(st.Sizes.Left), H: bh}
  else if value.IsEmpty(areas.Right) and x >= p.X + db.W - edge
    w = Get(st.Sizes.Right)
    return {Area: "Right", X: p.X + db.W - w, Y: top, W: w, H: bh}
  else if value.IsEmpty(areas.Bottom) and y >= top + bh - edge
    h = Get(st.Sizes.Bottom)
    return {Area: "Bottom", X: p.X, Y: top + bh - h, W: db.W, H: h}
  end
  h = hit(x, y, u)
  t = if value.IsMissing(h) 0 else above(h.Id, "tabs", u) end
  if t == 0 or above(t, "dock", u) != dk or u.Boxes[t].Node.Area == from
    return missing
  end
  q = at(t, u)
  {Area: u.Boxes[t].Node.Area, X: q.X, Y: q.Y, W: u.Boxes[t].W, H: u.Boxes[t].H}
end

(* The area where a dragged tab would go, over the page; none while no tab is dragged. *)
dropped(ui) = if value.IsMissing(ui.Drop) [] else ui.Kit.Drop(ui) end

defn dropItems(ui)
  (** The area where a dragged tab would go, lit over the page. *)
  d = ui.Drop
  if value.IsMissing(d)
    return []
  end
  t = ui.Theme
  [{Kind: "rect", X: d.X, Y: d.Y, W: d.W, H: d.H, Color: t.Accent, Radius: 0, Alpha: 56}, frame(d.X, d.Y, d.W, d.H, t.Accent)]
end

defn treeDown(h, ui)
  (** A press on a row of a tree: on its triangle, or on a row that only holds others, it opens or closes it; else it
      chooses it. *)
  u = focus(h.Id, ui)
  b = u.Boxes[h.Id]
  k = rowAt(h.Y, b)
  if value.IsMissing(k)
    return u
  end
  r = b.Cache.Rows[k]
  if r.Kids and (h.X < 4 + (r.Level - 1) * 14 + role("Icon", u.Theme) + 2 or value.IsMissing(r.Item.On) and value.IsMissing(dict.Get("To", r.Item)))
    toggleRow(b.Node, r)
  else
    chooseRow(b.Node, r, u)
  end
  u
end

defn toggleRow(n, r)
  (** Opens a row of a tree, or closes it. *)
  shut = Get(n.Closed)
  Set(n.Closed, if r.Item.Key in shut dict.Drop(r.Item.Key, shut) else dict.Put(r.Item.Key, true, shut) end)
end

defn chooseRow(n, r, ui)
  (** Chooses a row of a tree and runs what it does, or goes to its route: a row that is a link is chosen once its
      page shows, not while a page with changes not saved asks first. *)
  to = dict.Get("To", r.Item)
  if value.IsSome(to) and value.IsSome(ui.Router)
    _ = going(ui.Router, to, missing)
  end
  if value.IsMissing(to) or value.IsMissing(ui.Router) or nowOf(ui.Nav) == to
    Set(n.Chosen, r.Item.Key)
  end
  if value.IsFunction(r.Item.On)
    r.Item.On()
  end
end

defn treeKey(e, ui)
  (** The keys of a tree in focus: Up and Down choose the row above or under, Home and End the first and the last,
      Right opens a row or goes into it, Left closes it or goes to its parent, Enter and Space run it. *)
  b = ui.Boxes[ui.Focus]
  n = b.Node
  rows = b.Cache.Rows
  if value.IsEmpty(rows)
    return ui
  end
  i = 0
  for k in 1..value.Len(rows)
    if i == 0 and rows[k].Item.Key == b.Cache.Chosen
      i = k
    end
  end
  r = if i == 0 missing else rows[i] end
  k = e.Key
  if k == "down" or k == "up" or k == "home" or k == "end"
    j = if k == "down" list.Min(value.Len(rows), i + 1) else if k == "up" list.Max(1, i - 1) else if k == "home" 1 else value.Len(rows) end
    if j != i
      chooseRow(n, rows[j], ui)
    end
  else if value.IsMissing(r)
    return ui
  else if k == "right" and r.Kids
    if r.Open chooseRow(n, rows[i + 1], ui) else toggleRow(n, r) end
  else if k == "left"
    if r.Kids and r.Open
      toggleRow(n, r)
    else if r.Level > 1
      up = 0
      for j in 1..(i - 1)
        if rows[j].Level == r.Level - 1
          up = j
        end
      end
      if up > 0
        chooseRow(n, rows[up], ui)
      end
    end
  else if k == "enter" or k == "space"
    if value.IsFunction(r.Item.On) or value.IsSome(dict.Get("To", r.Item)) chooseRow(n, r, ui) else if r.Kids toggleRow(n, r) end
  end
  ui
end

defn tabsKey(e, ui)
  (** The keys of tabs in focus: Left and Right show the panel before or after, Home and End the first and the last. *)
  b = ui.Boxes[ui.Focus]
  n = b.Node
  to = {left: "Left", right: "Right", up: "Center", down: "Bottom"}
  if dict.GetOr("Alt", false, e) and dict.GetOr("Shift", false, e) and e.Key in to and value.IsSome(n.Dock)
    (* the panel shown goes to the area on that side, as a drag of its tab would take it, and the focus with it *)
    if to[e.Key] == n.Area or value.IsEmpty(n.Panels)
      return ui
    end
    movePanel(n.Dock, n.Panels[b.Cache.Chosen].Key, n.Area, to[e.Key])
    u = Update(keepDock(n.Dock, ui))
    there = areaTabs(n.Dock, to[e.Key], u)
    return if there == 0 u else focus(there, u, ring = true) end
  end
  if (e.Key == "enter" or e.Key == "space") and value.IsSome(dict.Get("Fold", b.Cache))
    Set(n.Dock.Fold, not b.Cache.Shut)
    return keepDock(n.Dock, ui)
  end
  count = value.Len(n.Panels)
  i = b.Cache.Chosen
  j = if e.Key == "left" list.Max(1, i - 1) else if e.Key == "right" list.Min(count, i + 1) else if e.Key == "home" 1 else if e.Key == "end" count else i end
  if j == i or count == 0
    return ui
  end
  Set(n.Chosen, j)
  keepDock(n.Dock, ui)
end

(* ---- The semantics tree and its patch *)

defn semDesk(b, x, y, ui, inner)
  (** The semantic nodes of a tree, tabs, a section or a toolbar, at x, y, inner those of its children. *)
  k = b.Node.Kind
  if k in ["nav", "chips", "pill", "metric", "asked", "picks", "pop", "shell"]
    shellSem(b, x, y, ui, inner)
  else if k == "tree"
    [treeSem(b, x, y, ui)]
  else if k == "tabs"
    tabsSem(b, x, y, ui, inner)
  else if k == "section"
    one = node("button", b.Cache.Text, b, x, y, ui)
    one.Expanded = b.Cache.Open
    [one]
  else
    [node("toolbar", "", b, x, y, ui, kids = inner)]
  end
end

defn treeSem(b, x, y, ui)
  (** The semantics of a tree: a node of each row in sight, with its level, whether it is open and whether chosen. *)
  c = b.Cache
  rows = []
  for k in 1..value.Len(c.Rows)
    r = c.Rows[k]
    one = {Id: "$(b.Id)t$k", Role: "treeitem", Name: shown(r.Item.Label), Value: if value.IsMissing(r.Item.Count) missing else shown(r.Item.Count) end,
      X: x, Y: y + (k - 1) * c.Row, W: b.W, H: c.Row, Focused: false, Kids: [], Level: r.Level, Selected: r.Item.Key == c.Chosen}
    if r.Kids
      one.Expanded = r.Open
    end
    if value.IsSome(dict.Get("To", r.Item))
      one.Href = r.Item.To
    end
    rows = list.Append(one, rows)
  end
  node("tree", b.Node.Label, b, x, y, ui, kids = rows)
end

defn tabsSem(b, x, y, ui, inner)
  (** The semantics of tabs: the list of the tabs, each a tab, the chosen one selected, then the chosen panel. *)
  c = b.Cache
  tabs = [{Id: "$(b.Id)l$k", Role: "tab", Name: c.Titles[k], Value: missing, X: x + c.Spans[k][1], Y: y, W: c.Spans[k][2], H: c.Tab, Focused: false, Kids: [],
    Selected: k == c.Chosen} for k in 1..value.Len(c.Titles)]
  strip = {Id: "$(b.Id)l", Role: "tablist", Name: b.Node.Label, Value: missing, X: x, Y: y, W: b.W, H: c.Tab, Focused: ui.Focus == b.Id, Kids: tabs}
  if value.IsSome(dict.Get("Fold", c))
    strip.Expanded = not c.Shut
  end
  panel = {Id: b.Id, Role: "tabpanel", Name: if value.IsEmpty(c.Titles) "" else c.Titles[c.Chosen] end, Value: missing, X: x, Y: y + c.Tab, W: b.W,
    H: b.H - c.Tab, Focused: false, Kids: inner}
  [strip, panel]
end

defn patchDesk(id, at, since, ui)
  (** The patch of a tree, tabs, a section or a toolbar, as semWalk makes the others': at is [rx, ry, x, y], its place
      from the nearest node above it that has a width and in the window. *)
  b = ui.Boxes[id]
  x = at[3]
  y = at[4]
  ax = x - at[1]
  ay = y - at[2]
  ex = at[1] if b.W > 0 else x
  ey = at[2] if b.W > 0 else y
  f = ui.Focus == id
  k = b.Node.Kind
  if k in ["nav", "chips", "pill", "metric", "asked", "picks", "pop", "shell"]
    return shellPatch(id, at, since, ui)
  end
  if k == "tree"
    return treePatch(id, b, ex, ey, x, y, f, ax, ay, at, ui)
  else if k == "tabs"
    return tabsPatch(id, b, ex, ey, x, y, f, ax, ay, at, since, ui)
  end
  old = b.Sem
  had = value.IsSome(old)
  was = if had old.Node else missing end
  loose = b.W <= 0
  if k == "section"
    e = json.Text([id, "button", b.Cache.Text, missing, ex, ey, b.W, b.H, f, {Expanded: b.Cache.Open}])
    sent(e, was)
    return kept(id, at, loose, [id], e, ui)
  end
  e = json.Text([id, "toolbar", "", missing, ex, ey, b.W, b.H, f, missing])
  sent(e, was)
  nax = x if b.W > 0 else ax
  nay = y if b.W > 0 else ay
  u = ui
  sids = []
  for c in b.Kids
    u = semWalk(c, nax, nay, x, y, since, u)
    sids = list.Concat(sids, u.Boxes[c].Sem.Sids)
    loose = loose or u.Boxes[c].Sem.Loose
  end
  ks = json.Text([id, sids])
  if not had or ks != old.Kids
    fiber.Send(ks, semKids)
  end
  kept(id, at, loose, [id], e, u, kids = ks)
end

defn treePatch(id, b, ex, ey, x, y, f, ax, ay, at, ui)
  (** The patch of a tree: its node and the rows that are new or changed, each a treeitem with its level, whether it
      is open and whether it is chosen. *)
  c = b.Cache
  n = b.Node
  old = b.Sem
  had = value.IsSome(old)
  e = json.Text([id, "tree", n.Label, missing, ex, ey, b.W, b.H, f, missing])
  sent(e, if had old.Node else missing end)
  nax = x if b.W > 0 else ax
  nay = y if b.W > 0 else ay
  before = if had old.Rows else dict.Dict() end
  rows = dict.Dict()
  ids = []
  for k in 1..value.Len(c.Rows)
    r = c.Rows[k]
    rid = "$(id)t$k"
    more = {Level: r.Level, Selected: r.Item.Key == c.Chosen}
    if r.Kids
      more.Expanded = r.Open
    end
    if value.IsSome(dict.Get("To", r.Item))
      more.Href = r.Item.To
    end
    re = json.Text([rid, "treeitem", shown(r.Item.Label), if value.IsMissing(r.Item.Count) missing else shown(r.Item.Count) end,
      x - nax, y + (k - 1) * c.Row - nay, b.W, c.Row, false, more])
    w = dict.Get(rid, before)
    sent(re, if value.IsSome(w) w else missing end)
    rows[rid] = re
    ids = list.Append(rid, ids)
  end
  ks = json.Text([id, ids])
  if not had or ks != old.Kids
    fiber.Send(ks, semKids)
  end
  kept(id, at, b.W <= 0, [id], e, ui, kids = ks, rows = rows)
end

defn tabsPatch(id, b, ex, ey, x, y, f, ax, ay, at, since, ui)
  (** The patch of tabs: the list of the tabs, each tab with whether it is chosen, and the panel of the chosen one,
      whose own nodes are those of its body. *)
  c = b.Cache
  n = b.Node
  old = b.Sem
  had = value.IsSome(old)
  lid = "$(id)l"
  strip = json.Text([lid, "tablist", n.Label, missing, ex, ey, b.W, c.Tab, f, if value.IsSome(dict.Get("Fold", c)) {Expanded: not c.Shut} else missing end])
  sent(strip, if had old.Head else missing end)
  before = if had old.Rows else dict.Dict() end
  tabs = dict.Dict()
  ids = []
  for k in 1..value.Len(c.Titles)
    tid = "$(lid)$k"
    te = json.Text([tid, "tab", c.Titles[k], missing, c.Spans[k][1], 0, c.Spans[k][2], c.Tab, false, {Selected: k == c.Chosen}])
    w = dict.Get(tid, before)
    sent(te, if value.IsSome(w) w else missing end)
    tabs[tid] = te
    ids = list.Append(tid, ids)
  end
  lk = json.Text([lid, ids])
  if not had or lk != old.Rows2
    fiber.Send(lk, semKids)
  end
  title = if value.IsEmpty(c.Titles) "" else c.Titles[c.Chosen] end
  e = json.Text([id, "tabpanel", title, missing, ex, ey + c.Tab, b.W, b.H - c.Tab, false, missing])
  sent(e, if had old.Node else missing end)
  nax = x if b.W > 0 else ax
  nay = y + c.Tab if b.W > 0 else ay
  u = ui
  sids = []
  loose = b.W <= 0
  for k in b.Kids
    u = semWalk(k, nax, nay, x, y, since, u)
    sids = list.Concat(sids, u.Boxes[k].Sem.Sids)
    loose = loose or u.Boxes[k].Sem.Loose
  end
  ks = json.Text([id, sids])
  if not had or ks != old.Kids
    fiber.Send(ks, semKids)
  end
  u.Boxes[id].Sem = {Rx: at[1], Ry: at[2], Ax: at[3], Ay: at[4], Loose: loose, Sids: [lid, id], Node: e, Kids: ks, Rows: tabs, Head: strip, Rows2: lk}
  u
end

(* ---- The layout that a dock keeps *)

defn keepDock(st, ui)
  (** Writes the layout of a dock where the back-end keeps it, when the dock has a key: its areas, sizes and chosen
      panels, as JSON. *)
  if value.IsMissing(st) or value.IsMissing(st.Key) or value.IsMissing(ui.Store)
    return ui
  end
  areas = ["Left", "Center", "Right", "Bottom"]
  ui.Store.Put("dock $(st.Key)", json.Text({Areas: Get(st.Areas), Sizes: {Left: Get(st.Sizes.Left), Right: Get(st.Sizes.Right), Bottom: Get(st.Sizes.Bottom)},
    Chosen: dict.Dict([{Key: a, Value: Get(st.Chosen[a])} for a in areas]), Fold: Get(st.Fold)}))
  ui
end

quiet(s, v) = put({Value: v, Version: version(s) + 1}, s.Cell)   (* A signal set before anything reads it. *)

defn restored(st, ui)
  (** The layout of a dock that the back-end kept, set in its signals as the dock is mounted: only the panels the dock
      has, each once; a panel that the layout kept doesn't know stays where the app put it; a size out of reason or
      a text that isn't the layout's JSON is left out. *)
  if value.IsMissing(st.Key) or value.IsMissing(ui.Store)
    return ui
  end
  raw = ui.Store.Get("dock $(st.Key)")
  got = if value.IsText(raw) and raw != "" json.Parse(raw) else result.Err({Message: "none"}) end
  if result.IsErr(got) or not value.IsDict(got.Value)
    return ui
  end
  v = got.Value
  names = ["Left", "Center", "Right", "Bottom"]
  areas = dict.Get("Areas", v)
  if value.IsDict(areas)
    seen = dict.Dict()
    out = {Left: [], Center: [], Right: [], Bottom: []}
    for a in names
      xs = dict.Get(a, areas)
      for x in if value.IsArray(xs) xs else [] end
        if value.IsText(x) and x in st.Panels and not (x in seen)
          seen[x] = true
          out[a] = list.Append(x, out[a])
        end
      end
    end
    for a in names
      for x in st.First[a]
        if not (x in seen)
          seen[x] = true
          out[a] = list.Append(x, out[a])
        end
      end
    end
    quiet(st.Areas, out)
  end
  sizes = dict.Get("Sizes", v)
  if value.IsDict(sizes)
    for a in ["Left", "Right", "Bottom"]
      s = dict.Get(a, sizes)
      if value.IsNumber(s) and s >= 40 and s <= 4000
        quiet(st.Sizes[a], math.Div(math.Round(s), 1))
      end
    end
  end
  fold = dict.Get("Fold", v)
  if value.IsBool(fold)
    quiet(st.Fold, fold)
  end
  chosen = dict.Get("Chosen", v)
  if value.IsDict(chosen)
    for a in names
      c = dict.Get(a, chosen)
      if value.IsNumber(c) and c >= 1 and c <= 1000
        quiet(st.Chosen[a], math.Div(math.Round(c), 1))
      end
    end
  end
  ui
end
